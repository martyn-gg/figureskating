---
import { label, mirror, exitState, chainStates } from '../lib/skating.js';
const { entry, turn, turns, caption } = Astro.props;
/* One turn or a cluster of them. The caption walks the whole chain, because on a
   three-turn cluster the interesting part is the edges in the middle. */
const chain = turns?.length ? turns : (turn ? [turn] : []);
const states = chainStates(entry, chain);
const exit = states.at(-1);
const m = mirror(entry);
const mirrored = chainStates(m, chain);
/* Which edges this tracing actually visits, so the key names those and no others.
   A legend for an inside edge on a diagram with no inside edge in it would be
   asserting a distinction this element does not make. */
const visits = { O: states.some(s => s.edge === 'O'), I: states.some(s => s.edge === 'I') };
---
<figure class="diagram">
  <svg
    role="img"
    aria-label={`Tracing of ${label(entry)}${chain.length ? ` through a ${chain.join(', then a ')}` : ''}`}
    data-foot={entry.foot} data-edge={entry.edge} data-dir={entry.dir}
    data-turn={turns?.length ? '' : (turn ?? '')}
    data-turns={turns?.length ? turns.join(',') : ''}></svg>
  <div class="dctl">
    <button type="button" data-play aria-label="Play or pause">❚❚</button>
    <button type="button" class="spd" data-speed aria-label="Playback speed, currently full speed">1×</button>
    <input type="range" min="0" max="1000" value="0" data-scrub aria-label="Scrub" />
    <label class="mir"><input type="checkbox" data-mirror /> mirror</label>
  </div>
  {/* The two edges differ in lightness as well as hue, so the key can name the
      difference in words a greyscale print still supports. */}
  <div class="key">
    {visits.O && <span><i class="sw out"></i>outside edge — the paler line</span>}
    {visits.I && <span><i class="sw in"></i>inside edge — the darker line</span>}
  </div>
  <figcaption>
    {caption ?? <>
      {states.map((st, i) => (
        <>{i ? ' → ' : ''}<b data-lab data-a={label(st)} data-b={label(mirrored[i])}>{label(st)}</b></>
      ))}.{' '}
      <span data-lab-note>A skater who rotates the other way traces <b>{label(m)}</b> — same element, generated not redrawn.</span>
    </>}
  </figcaption>
</figure>

<style>
  .diagram{margin:1.75rem 0;background:var(--ice);border:1px solid var(--ice-line);
    border-radius:12px;overflow:hidden}
  .diagram svg{display:block;width:100%;height:auto}
  .dctl{display:flex;align-items:center;gap:.6rem;padding:.5rem .7rem;border-top:1px solid var(--ice-line)}
  /* 44 px. This is used one-handed, on a phone, in gloves; it was 34. */
  .dctl button{width:44px;height:44px;flex:none;border-radius:999px;border:1px solid var(--ice-line);
    background:var(--paper);color:var(--ink);cursor:pointer;font-size:13px;line-height:1}
  /* Wider than the play button, because it carries a label rather than a glyph. */
  .dctl button.spd{width:auto;min-width:44px;padding:0 .6rem;font-size:.86rem;
    font-family:ui-sans-serif,-apple-system,sans-serif;font-variant-numeric:tabular-nums}
  .dctl button.spd[data-slow]{border-color:var(--accent);color:var(--accent)}
  .dctl input[type=range]{flex:1;accent-color:var(--accent);min-width:0;height:44px}
  .mir{font-family:ui-sans-serif,-apple-system,sans-serif;font-size:.82rem;color:var(--ink-soft);
    display:flex;align-items:center;gap:.4rem;cursor:pointer;white-space:nowrap;min-height:44px}
  .mir input{width:20px;height:20px;accent-color:var(--accent)}
  .key{display:flex;flex-wrap:wrap;gap:.35rem 1.1rem;padding:.6rem .9rem;
    border-top:1px solid var(--ice-line);font-family:ui-sans-serif,-apple-system,sans-serif;
    font-size:.78rem;color:var(--ink-soft)}
  .key span{display:flex;align-items:center;gap:.4rem}
  .key .sw{display:block;width:26px;height:5px;border-radius:3px;flex:none}
  .key .sw.out{background:var(--edge-out)}
  .key .sw.in{background:var(--edge-in)}
  figcaption{padding:.7rem .9rem;font-family:ui-sans-serif,-apple-system,sans-serif;
    font-size:.82rem;color:var(--ink-soft);border-top:1px solid var(--ice-line)}
  figcaption b{color:var(--ink)}
  @media (prefers-reduced-motion: reduce){ .diagram svg{--paused:1} }
</style>

<script>
  import { mount } from '../lib/edge-diagram.js';

  for (const fig of document.querySelectorAll('.diagram')) {
    const svg = fig.querySelector('svg');
    const play = fig.querySelector('[data-play]');
    const scrub = fig.querySelector('[data-scrub]');
    const mirrorBox = fig.querySelector('[data-mirror]');
    const base = { foot: svg.dataset.foot, edge: svg.dataset.edge, dir: svg.dataset.dir };
    const labs = fig.querySelectorAll('[data-lab]');
    const note = fig.querySelector('[data-lab-note]');
    const turn = svg.dataset.turn || null;
    const turns = svg.dataset.turns ? svg.dataset.turns.split(',') : null;
    const spd = fig.querySelector('[data-speed]');
    /* Discrete steps rather than a slider: this gets used one-handed, on a phone,
       in gloves, and a slider needs a grip a glove does not have. */
    const RATES = [[1, '1×', 'full speed'], [.5, '½×', 'half speed'],
                   [.25, '¼×', 'quarter speed'], [.125, '⅛×', 'an eighth of full speed']];
    let rate = 0;
    let view = null;

    const build = () => {
      view?.destroy();
      const entry = mirrorBox.checked ? { ...base, foot: base.foot === 'L' ? 'R' : 'L' } : base;
      view = mount(svg, { entry, turn, turns, onFrame: n => { scrub.value = String(Math.round(n)); } });
      scrub.max = String(view.frames - 1);
      view.speed = RATES[rate][0];
      /* The caption has to follow the toggle, or the page describes one tracing
         while showing the other. */
      for (const b of labs) b.textContent = mirrorBox.checked ? b.dataset.b : b.dataset.a;
      if (note) note.hidden = mirrorBox.checked;
      /* Anyone who has asked the system not to animate things gets a still frame
         mid-turn, which is the informative one anyway. */
      if (matchMedia('(prefers-reduced-motion: reduce)').matches) {
        view.playing = false; play.textContent = '▶';
        view.seek(Math.round(view.frames * 0.5)); scrub.value = String(Math.round(view.frames * 0.5));
      }
    };

    play.addEventListener('click', () => {
      view.playing = !view.playing;
      play.textContent = view.playing ? '❚❚' : '▶';
    });
    scrub.addEventListener('input', () => {
      view.playing = false; play.textContent = '▶'; view.seek(Number(scrub.value));
    });
    spd.addEventListener('click', () => {
      rate = (rate + 1) % RATES.length;
      const [v, text, words] = RATES[rate];
      spd.textContent = text;
      spd.setAttribute('aria-label', `Playback speed, currently ${words}`);
      if (rate) spd.setAttribute('data-slow', ''); else spd.removeAttribute('data-slow');
      view.speed = v;
      /* Choosing a speed and seeing nothing move is a dead control. */
      if (!view.playing) { view.playing = true; play.textContent = '❚❚'; }
    });
    mirrorBox.addEventListener('change', build);
    build();
  }
</script>
