---
/* A PATTERN DANCE ON THE RINK — 03/10/2026, Martyn: draw the patterns, and put them
   in the outline of a 60 x 30 metre rink.

   MEASURED, NOT MODELLED. The first attempt drew each step as an arc turning in
   proportion to its beats, and it failed: a four-beat edge down the side barely
   bends while a two-beat edge round the end turns ninety degrees, so how far a step
   turns is a fact of where it sits on the ice, not of its count. The step list does
   not hold that fact; the governing body's diagram does. So each pattern is measured
   off U.S. Figure Skating's diagram (tools/dance-pattern/gen.py), into metres on the
   rink, and stored in src/data/patterns/<slug>.json with the page it came from. Where
   Skate Canada draws the same dance, its diagram is traced too and the two compared
   step by step, and the caption says how closely they agree. Martyn agreed on
   03/10/2026 that this is a redraw of their diagram and that this is fine here.

   THE FRAME. x runs along the long axis, -30 to 30, in the direction of travel along
   the side the dance starts on; y runs across, -15 to 15, with +y that side. It is
   drawn upright, as U.S. Figure Skating and Skate Canada both draw their diagrams:
   x up the page and +y to the right, so the dance starts low on the right and
   travels up it, anticlockwise. Martyn, 03/10/2026: upright, so a skater holding
   the guide beside a rulebook sees the same picture, and a phone gets twice the
   scale.

   HALF A CIRCUIT IS DRAWN TWICE. Where the step list covers one side and one end (the
   Dutch Waltz), the second sequence is the first turned through 180 degrees about the
   centre of the ice, which is how the rulebook draws it and how a skater repeats it.
   It is drawn faint and unnumbered. tools/dance-pattern/gen.py measures how far the
   diagram's own second half sits from that turn, and the file records it.

   COLOUR FOLLOWS THE EDGE, the guide's rule everywhere else: outside and inside take
   their two colours, and a step that changes edge (RFOI) takes neither, because one
   colour on it would name one of its two edges wrongly. The edge comes from the
   dance's own step list, not the diagram's label; tools/dance.mjs holds the two to
   each other. */
import { edgeOfCode } from '../lib/dance.js';

const { slug, dance } = Astro.props;
const files = import.meta.glob('../data/patterns/*.json', { eager: true });
const P = files[`../data/patterns/${slug}.json`]?.default;

/* Each partner's step list: the follow's where the chart gives one. */
const rowsOf = who => dance.steps
  ? dance.steps.map(s => ({ n: String(s.n), code: s.edge }))
  : dance.chart.map(r => ({ n: String(r.n), code: (who === 'follow' ? r.follow : r.lead) || r.lead || r.follow }));
/* The diagram's own label names the edge it draws; tools/dance.mjs holds it to the
   step list, which matters where one chart cell holds two steps ("LFO XF-RFI") and
   the diagram draws the one it labels. A label naming no edge falls back to the
   step list. */
const edgeOf = (who, n, label) => {
  if (/[LR][FB](OI|IO|O|I)/.test(label || '')) return edgeOfCode(label);
  const r = rowsOf(who).find(x => x.n === n);
  return r ? edgeOfCode(r.code) : null;
};
const ink = e => e === 'O' ? 'var(--edge-out)' : e === 'I' ? 'var(--edge-in)' : 'var(--ink)';
const X = P && P.check && P.check.crossCheck;
const startOf = steps => /^M\s*(-?[\d.]+)[ ,](-?[\d.]+)/.exec(steps[0].d);
/* THE PARTNERS, SWITCHABLE — 03/10/2026, Martyn. Where the partners skate different
   steps and the follow's read cleanly, both are drawn and a switch shows one at a
   time. They skate side by side on one track, so the line barely moves; what
   changes is where each step begins and which edge it is on, and the colours show
   it. A CSS switch (radio buttons and :has), so it works without script. */
const layers = P ? [{ who: 'lead', steps: P.steps }, ...(P.follow ? [{ who: 'follow', steps: P.follow.steps }] : [])] : [];
---
{P && (
  <figure class="pattern">
    {P.follow && (
      <fieldset class="who">
        <legend>Steps for</legend>
        <label><input type="radio" name="partner" value="lead" checked /> the lead</label>
        <label><input type="radio" name="partner" value="follow" /> the follow</label>
      </fieldset>
    )}
    <svg viewBox="-17.5 -32 35 64" role="img"
      aria-label={`The ${dance.name || 'dance'} pattern on a 60 by 30 metre rink, ${P.steps.length} steps, numbered in order`}>
      <rect x="-15" y="-30" width="30" height="60" rx="8.5" class="rink" />
      <line x1="0" y1="-30" x2="0" y2="30" class="axis" />
      <line x1="-15" y1="0" x2="15" y2="0" class="axis" />
      {layers.map(({ who, steps }) => { const st = startOf(steps); return (
        <g class={`partner p-${who}`}>
          <g transform="matrix(0 -1 1 0 0 0)">
            {P.circuit === 'half' && (
              <g transform="rotate(180)" class="repeat">
                {steps.filter(s => !s.point).map(s => <path d={s.d} stroke={ink(edgeOf(who, s.n, s.label))} />)}
              </g>
            )}
            {who === 'lead' && P.dashed && P.dashed.d.map(d => <path d={d} class="dashed" />)}
            <g class="steps">
              {steps.map(s => s.point
                ? <circle cx={s.point[0]} cy={s.point[1]} r="0.55" class="hop"><title>{`Step ${s.n}, ${s.label || 'a hop'}`}</title></circle>
                : <path d={s.d} stroke={ink(edgeOf(who, s.n, s.label))}><title>{`Step ${s.n}`}</title></path>)}
            </g>
            {st && <circle cx={st[1]} cy={st[2]} r="0.7" class="start" />}
          </g>
          <g class="nums">
            {steps.map(s => <text x={s.at[1]} y={-s.at[0]}>{s.n}</text>)}
          </g>
        </g>); })}
    </svg>
    <figcaption>
      One sequence on a 60 x 30 metre rink, drawn upright as the rulebooks draw it,
      starting at the dot and travelling anticlockwise.
      {!dance.sameSteps && (P.follow
        ? ' The two partners skate side by side on one track; the switch shows where each one\'s steps fall and on which edge.'
        : ' These are the lead\'s steps.')}
      {P.circuit === 'half' && ' The faint half is the same steps skated again.'}
      {P.dashed && ` The dashed line is ${P.dashed.is}.`}
      {layers.some(l => l.steps.some(s => s.point)) && ' A ring marks a hop or a toe pick, which leaves no tracing of its own.'}
      {' '}Rinks vary, and on a smaller one the pattern shrinks to fit.
      Measured from the diagram in {P.source}{P.follow && P.follow.source !== P.source ? `, and the follow's from ${P.follow.source.replace(/^U\.S\. Figure Skating 2026-27 Rulebook, /, '')}` : ''}.
      {X && ` Skate Canada's diagram of the same dance is drawn at a different size; allowing for that, its steps sit on average ${X.meanApartAfterScaling.toFixed(1)} m from these.`}
    </figcaption>
  </figure>
)}

<style>
  .pattern { margin: 1rem 0 1.25rem; }
  /* Upright, as both rulebooks draw it: on a phone the rink's 30 m width takes the
     screen's width, twice the scale a sideways rink gets. On a wide screen it is
     held to a column beside the step table rather than a tower above it. */
  @media (min-width: 760px) {
    .pattern { float: right; width: 340px; margin: 0.25rem 0 1rem 1.5rem; }
  }
  .pattern svg { width: 100%; height: auto; display: block; }
  .who { border: 0; padding: 0; margin: 0 0 0.4rem; display: flex; gap: 1rem; align-items: baseline; font-size: 0.9rem; }
  .who legend { float: left; padding: 0; margin-right: 0.5rem; color: var(--ink-soft); }
  .who label { cursor: pointer; }
  .p-follow { display: none; }
  .pattern:has(input[value="follow"]:checked) .p-follow { display: inline; }
  .pattern:has(input[value="follow"]:checked) .p-lead { display: none; }
  .rink { fill: var(--ice); stroke: var(--ink-soft); stroke-width: 0.18; }
  .axis { stroke: var(--ink-soft); stroke-width: 0.08; stroke-dasharray: 1.2 0.5 0.2 0.5; opacity: 0.6; }
  path { fill: none; stroke-width: 0.38; stroke-linecap: round; stroke-linejoin: round; }
  .repeat path { opacity: 0.28; }
  .dashed { stroke: var(--ink-soft); stroke-dasharray: 0.6 0.45; stroke-width: 0.26; }
  .start { fill: var(--ink); }
  .hop { fill: var(--ice); stroke: var(--ink); stroke-width: 0.2; }
  .nums text { font-size: 1.45px; text-anchor: middle; dominant-baseline: central; fill: var(--ink); font-weight: 600; }
  figcaption { font-size: 0.85rem; color: var(--ink-soft); margin-top: 0.4rem; }
</style>
