---
import { MOVES } from '../lib/moves.js';
const { move, views = 'top,side,rear', controls = true } = Astro.props;
const m = MOVES[move];
---
{m && (
<figure class="bf" data-move={move} data-views={views}>
  <div class="bf-views"></div>
  {controls && (
    <div class="bf-ctl">
      <button type="button" data-play aria-label="Play or pause">❚❚</button>
      <input type="range" min="0" max="1000" value="0" data-scrub aria-label="Scrub" />
    </div>
    <p class="bf-phase" data-phase></p>
  )}
  <div class="bf-readouts">
    <span>shoulder to hip <b data-twist>—</b></span>
    <span>on the <b data-blade>—</b></span>
  </div>
  <figcaption>
    {m.note}. Negative twist means the shoulders are held back against the hips — what
    stores rotation before a takeoff and checks it on a landing.
  </figcaption>
</figure>
)}


<script>
  import { mount } from '../lib/body-frame.js';

  for (const fig of document.querySelectorAll('.bf')) {
    const host = fig.querySelector('.bf-views');
    const play = fig.querySelector('[data-play]');
    const scrub = fig.querySelector('[data-scrub]');
    const phase = fig.querySelector('[data-phase]');
    const twist = fig.querySelector('[data-twist]');
    const blade = fig.querySelector('[data-blade]');
    let lastWrite = 0;

    const rig = mount(host, {
      move: fig.dataset.move,
      views: fig.dataset.views.split(','),
      onFrame(i, pose, tw, zone) {
        /* Ten updates a second is unreadable. Write at most eight, and only when
           the string has actually changed. */
        const now = performance.now();
        if (now - lastWrite < 130) { if (scrub && document.activeElement !== scrub) scrub.value = String(Math.round(i)); return; }
        lastWrite = now;
        if (scrub && document.activeElement !== scrub) scrub.value = String(Math.round(i));
        if (phase && phase.textContent !== pose.ph) phase.textContent = pose.ph;
        if (twist) twist.textContent = `${tw > 0 ? '+' : ''}${tw}°`;
        if (blade && blade.textContent !== zone) blade.textContent = zone;
      },
    });
    if (scrub) scrub.max = String(rig.frames - 1);

    play?.addEventListener('click', () => {
      rig.playing = !rig.playing;
      play.textContent = rig.playing ? '❚❚' : '▶';
    });
    scrub?.addEventListener('input', () => {
      rig.playing = false; play.textContent = '▶'; rig.seek(Number(scrub.value));
    });
    if (matchMedia('(prefers-reduced-motion: reduce)').matches) {
      rig.playing = false; if (play) play.textContent = '▶';
      rig.seek(Math.round(rig.frames * 0.45));
    }
  }
</script>
