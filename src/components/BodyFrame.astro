---
import { MOVES, entrancesOf, phasesOf } from '../lib/moves.js';
import { RATES, rateIndex } from '../lib/body-frame.js';
const { move, views = 'top,side,rear', controls = true } = Astro.props;
const m = MOVES[move];
/* ENTRANCES — 04/10/2026, Session 34 (moves.js ENTRIES). A jump or spin that has more than
   one entrance offers them as buttons, the one the move was written with first; each is a
   move of its own, so switching remounts the rig. The strip under the controls marks where
   the entrance ends and the exit begins, read off the move. */
const options = controls ? entrancesOf(move) : [];
const strip = id => { const p = phasesOf(id);
  return p && (p.entry > 0 || p.exit < 1) ? [p.entry, p.exit - p.entry, 1 - p.exit].map(x => (100 * x).toFixed(2)) : null; };
const middle = m && m.path.some(g => g.kind === 'line') ? 'Jump' : 'Spin';
const bar = options.length ? strip(move) : null;
/* The button's opening label comes from the same list the script cycles, so the
   server-rendered markup and the client cannot disagree about it. */
const rate0 = rateIndex(m);
const [, rateText, rateWords] = RATES[rate0];
---
{m && (
<figure class="bf" data-move={move} data-views={views}>
  {options.length > 1 && (
    <div class="bf-entries" role="group" aria-label="Entrance">
      <span>Entrance</span>
      {options.map((o, i) => (
        <button type="button" data-entry={o.move} aria-pressed={i === 0 ? 'true' : 'false'}
                data-note={MOVES[o.move].note} data-bar={(strip(o.move) || []).join(',')}>{o.name}</button>
      ))}
    </div>
  )}
  {options.length === 1 && <p class="bf-entries"><span>Entrance</span> {options[0].name}</p>}
  <div class="bf-views"></div>
  {controls && (<>
    <div class="bf-ctl">
      <button type="button" data-play aria-label="Play or pause">❚❚</button>
      <button type="button" class="spd" data-speed data-rate={rate0} data-slow={rate0 ? '' : undefined}
            aria-label={`Playback speed, currently ${rateWords}`}>{rateText}</button>
      <input type="range" min="0" max="1000" value="0" data-scrub aria-label="Scrub" />
    </div>
    {bar && (
      <div class="bf-phases" aria-hidden="true" data-phases>
        <span style={`flex-basis:${bar[0]}%`}>Entrance</span><span style={`flex-basis:${bar[1]}%`}>{middle}</span><span style={`flex-basis:${bar[2]}%`}>Exit</span>
      </div>
    )}
    <p class="bf-phase" data-phase></p>
  </>)}
  <div class="bf-readouts">
    <span>shoulder to hip <b data-twist>—</b></span>
    <span>on the <b data-blade>—</b></span>
  </div>
  <figcaption>
    <span data-note>{m.note}</span>. Negative twist means the shoulders are held back against the hips, which
    stores rotation before a takeoff and checks it on a landing.
  </figcaption>
</figure>
)}


<script>
  import { mount, RATES } from '../lib/body-frame.js';

  for (const fig of document.querySelectorAll('.bf')) {
    const host = fig.querySelector('.bf-views');
    const play = fig.querySelector('[data-play]');
    const scrub = fig.querySelector('[data-scrub]');
    const phase = fig.querySelector('[data-phase]');
    const twist = fig.querySelector('[data-twist]');
    const blade = fig.querySelector('[data-blade]');
    let lastWrite = 0;

    const start = id => mount(host, {
      move: id,
      views: fig.dataset.views.split(','),
      onFrame(i, pose, tw, zone) {
        /* Ten updates a second is unreadable. Write at most eight, and only when
           the string has actually changed. */
        const now = performance.now();
        if (now - lastWrite < 130) { if (scrub && document.activeElement !== scrub) scrub.value = String(Math.round(i)); return; }
        lastWrite = now;
        if (scrub && document.activeElement !== scrub) scrub.value = String(Math.round(i));
        if (phase && phase.textContent !== pose.ph) phase.textContent = pose.ph;
        if (twist) twist.textContent = `${tw > 0 ? '+' : ''}${tw}°`;
        if (blade && blade.textContent !== zone) blade.textContent = zone;
      },
    });
    let rig = start(fig.dataset.move);
    if (scrub) scrub.max = String(rig.frames - 1);

    play?.addEventListener('click', () => {
      rig.playing = !rig.playing;
      play.textContent = rig.playing ? '❚❚' : '▶';
    });
    scrub?.addEventListener('input', () => {
      rig.playing = false; play.textContent = '▶'; rig.seek(Number(scrub.value));
    });

    /* The whole reason this rig exists is to be watched slowly. The rate the
       move opens at is rendered into the button server-side; the cycle picks up
       from there. */
    const spd = fig.querySelector('[data-speed]');
    let rate = Number(spd?.dataset.rate ?? 0);
    spd?.addEventListener('click', () => {
      rate = (rate + 1) % RATES.length;
      const [v, text, words] = RATES[rate];
      spd.textContent = text;
      spd.setAttribute('aria-label', `Playback speed, currently ${words}`);
      if (rate) spd.setAttribute('data-slow', ''); else spd.removeAttribute('data-slow');
      rig.speed = v;
      if (!rig.playing) { rig.playing = true; if (play) play.textContent = '❚❚'; }
    });

    const note = fig.querySelector('[data-note]'), phases = fig.querySelector('[data-phases]');
    for (const b of fig.querySelectorAll('[data-entry]')) b.addEventListener('click', () => {
      if (b.getAttribute('aria-pressed') === 'true') return;
      const playing = rig.playing, speed = rig.speed;
      rig.destroy();
      rig = start(b.dataset.entry);
      rig.playing = playing; rig.speed = speed;
      if (scrub) scrub.max = String(rig.frames - 1);
      for (const o of fig.querySelectorAll('[data-entry]')) o.setAttribute('aria-pressed', String(o === b));
      if (note) note.textContent = b.dataset.note;
      if (phases && b.dataset.bar) b.dataset.bar.split(',').forEach((w, i) => { phases.children[i].style.flexBasis = w + '%'; });
    });

    if (matchMedia('(prefers-reduced-motion: reduce)').matches) {
      rig.playing = false; if (play) play.textContent = '▶';
      rig.seek(Math.round(rig.frames * 0.45));
    }
  }
</script>
