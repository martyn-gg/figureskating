---
const { verified, what = 'mechanics' } = Astro.props;
---
{!verified?.checked && (
  <p class="unverified">
    <b>Unverified.</b> The {what} on this page are a first draft by a non-expert and have not
    been checked by a coach. Read them as a starting point and check them with a coach.
    Corrections are very welcome, and the repository is public.
  </p>
)}
{verified?.checked && (
  <p class="meta"><span class="chip">Checked{verified.by ? <> by <b>{verified.by}</b></> : null}</span></p>
)}
