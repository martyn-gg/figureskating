---
import { correctionHref } from '../lib/site.js';
const { verified, what = 'mechanics', title = '' } = Astro.props;
const href = correctionHref(title, new URL(Astro.url.pathname, Astro.site).href);
---
{!verified?.checked && (
  <p class="unverified">
    <b>Not checked yet.</b> The {what} on this page are a first draft by a non-expert, and
    no coach has seen them yet. Read them as a starting point and check them with a coach.{' '}
    <a href={href}>Corrections are very welcome</a>.
  </p>
)}
{verified?.checked && (
  <p class="meta"><span class="chip">Checked{verified.by ? <> by <b>{verified.by}</b></> : null}</span></p>
)}
