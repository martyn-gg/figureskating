---
/* THE BLADE FROM THE SIDE — 04/10/2026, Session 28; redrawn the same day (Martyn: a
   blade-profile drawing elsewhere showed the spin rocker and the pick better than one
   curve could).

   A figure blade is usually ground to more than one radius: a long, flat main rocker,
   then a tighter spin rocker towards the front, and on a three-radius blade a tighter
   curve still running up to the pick. Two-radius blades are also sold (a retailer's
   blade guide lists two of each, read 04/10/2026). This draws one common profile of that kind, chained arc to arc with no
   kink, from the lowest point outwards. The radii and the lengths are illustrative:
   profiles differ from blade to blade, and the page says so.

   The guide's figures stand on something simpler, one radius of ROCKER along the whole
   blade (rig-math.js), and the caption says that too. The main rocker drawn here is
   that radius. */
import { ROCKER } from '../lib/rig-math.js';

const IN = 2.54;
/* Forward from the lowest point: [radius cm, length cm]. Backward: the main rocker to
   the heel. Lengths are along the blade. */
const FORWARD = [[ROCKER, 5], [27 * IN, 4.5], [12 * IN, 3.5]];
const BACK = 13;
const PICK = [12 * IN, 2.6];          // the teeth continue the last curve
const EX = 3;                          // vertical exaggeration
const PX = 16;                         // px per cm along the blade

/* Walk the blade by arc length, turning by 1/radius per cm. Returns points (x along,
   h up) and the index where each segment ends. */
const walk = (segs, dir) => {
  let x = 0, h = 0, th = 0;
  const pts = [[0, 0]], ends = [];
  for (const [r, len] of segs) {
    const n = Math.ceil(len * 4);
    for (let i = 0; i < n; i++) {
      const ds = len / n;
      th += ds / r;
      x += dir * Math.cos(th) * ds; h += Math.sin(th) * ds;
      pts.push([x, h]);
    }
    ends.push(pts.length - 1);
  }
  return { pts, ends };
};
const fwd = walk([...FORWARD, PICK], 1);
const back = walk([[ROCKER, BACK]], -1);

const xs = [...fwd.pts, ...back.pts].map(p => p[0]);
const x0 = Math.min(...xs) - 2, x1 = Math.max(...xs) + 6;
const hPick = fwd.pts[fwd.pts.length - 1][1];
const W = (x1 - x0) * PX, GROUND = 24 + hPick * EX * PX, H = GROUND + 70;
const X = x => (x - x0) * PX;
const Y = h => GROUND - h * EX * PX;
const TOP = Y(hPick) - 2;
const P = ([x, h]) => `${X(x).toFixed(1)} ${Y(h).toFixed(1)}`;

/* The running surface, heel to the start of the pick, as one path per segment so each
   can carry its own colour. */
const segPath = (pts, a, b) => `M${pts.slice(a, b + 1).map(P).join(' L')}`;
const runs = [
  { d: segPath([...back.pts].reverse().concat(fwd.pts.slice(1)), 0, back.pts.length - 1 + fwd.ends[0]), cls: 'main', label: `${Math.round(ROCKER / 30.48)} ft main rocker`, at: 0 },
  { d: segPath(fwd.pts, fwd.ends[0], fwd.ends[1]), cls: 'spin', label: 'spin rocker', at: 1 },
  { d: segPath(fwd.pts, fwd.ends[1], fwd.ends[2]), cls: 'front', label: '', at: 2 },
];
/* The teeth: notches cut into the last stretch of the curve. */
const pickPts = fwd.pts.slice(fwd.ends[2]);
const teeth = pickPts.map((p, i) => {
  const [x, h] = p;
  if (i % 3 !== 1) return P(p);
  return `${(X(x) - 6).toFixed(1)} ${(Y(h) - 9).toFixed(1)}`;
});
const heel = back.pts[back.pts.length - 1];
const body = `M${X(heel[0]).toFixed(1)} ${TOP} L${P(heel)} ` +
  [...back.pts].reverse().concat(fwd.pts.slice(1, fwd.ends[2] + 1)).map(p => `L${P(p)}`).join(' ') +
  ` ${teeth.map(t => `L${t}`).join(' ')} L${(X(pickPts[pickPts.length - 1][0]) + 4).toFixed(1)} ${TOP} Z`;
const mid = (pts, a, b) => pts[Math.round((a + b) / 2)];
const labelAt = [
  { x: X(-4), text: `${Math.round(ROCKER / 30.48)} ft main rocker` },
  { x: X(mid(fwd.pts, fwd.ends[0], fwd.ends[1])[0]), text: 'spin rocker', row: 1 },
  { x: X(mid(fwd.pts, fwd.ends[1], fwd.ends[2])[0]) + 8, text: '12 in' },
];
const pickTop = pickPts[pickPts.length - 1];
---
<figure class="kitfig">
  <svg viewBox={`0 0 ${W.toFixed(0)} ${H.toFixed(0)}`} role="img" aria-label="A figure blade from the side, heel on the left: a long main rocker, a tighter spin rocker towards the front, a tighter curve still, and the toe pick at the front.">
    <line x1="0" x2={W} y1={GROUND} y2={GROUND} class="ice" />
    <path d={body} class="steel" />
    {runs.map(r => <path d={r.d} class={`zone ${r.cls}`} />)}
    {labelAt.map(l => <text x={l.x} y={GROUND + (l.row ? 52 : 26)} text-anchor="middle">{l.text}</text>)}
    <text x={X(pickTop[0]) + 12} y={Y(pickTop[1]) + 30} text-anchor="start">pick</text>
    <text x={X(heel[0]) + 2} y={GROUND + 52} text-anchor="start">heel</text>
  </svg>
  <figcaption>
    Heel on the left, toe on the right, height drawn {EX} times taller than it is. One
    three-radius profile: {Math.round(ROCKER / 30.48)} ft along most of the blade, 27 in for the spin rocker and 12 in up to
    the pick. A two-radius blade has no separate third curve, and profiles differ from
    blade to blade. The skaters drawn elsewhere in this guide
    stand on a simpler blade, the {Math.round(ROCKER / 30.48)} ft curve all the way along.
  </figcaption>
</figure>
<style>
  .kitfig{margin:1.5rem 0;padding:1rem .9rem .2rem;background:var(--ice);border:1px solid var(--ice-line);border-radius:12px}
  .kitfig svg{display:block;width:100%;height:auto}
  .ice{stroke:var(--ice-line);stroke-width:2}
  .steel{fill:var(--ice-line);stroke:var(--ink-soft);stroke-width:1.5;stroke-linejoin:round}
  .zone{fill:none;stroke-width:6;stroke-linecap:butt}
  .main{stroke:var(--edge-out)}
  .spin{stroke:var(--edge-in)}
  .front{stroke:var(--ink-soft)}
  text{font:21px ui-sans-serif,-apple-system,sans-serif;fill:var(--ink-soft)}
  figcaption{margin:.6rem 0 0;padding:.6rem .1rem .8rem;border-top:1px solid var(--ice-line);
    font-family:ui-sans-serif,-apple-system,sans-serif;font-size:.86rem;color:var(--ink-soft);line-height:1.5}
</style>
