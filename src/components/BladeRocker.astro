---
/* THE BLADE FROM THE SIDE, DRAWN FROM THE RIG'S OWN NUMBERS — 04/10/2026, Session 28.

   Every figure in the guide stands on this blade: rig-math.js grinds it to ROCKER,
   runs it from BLADE_BACK to BLADE_FRONT, puts the pick's deepest tooth at PICK_ALONG,
   and names the part of the blade a skater is on with bladeZone. This draws those, and
   nothing else, so the picture and the skater cannot disagree. The zones are found by
   asking bladeZone along the whole blade, not by copying its thresholds.

   The curve is drawn EX times taller than it is, and the figure says so: at true scale
   a 7 ft rocker over a blade's running length is too flat to see, which is the point
   the caption makes in numbers. */
import { ROCKER, BLADE_FRONT, BLADE_BACK, PICK_ALONG, MAX_BLADE_PITCH, contactAlong, bladeZone } from '../lib/rig-math.js';

const EX = 5;                        // vertical exaggeration (Martyn, 04/10/2026: 10 read too curved)
const PX = 16;                       // px per cm along the blade
const sag = x => ROCKER - Math.sqrt(ROCKER * ROCKER - x * x);   // cm above the lowest point
const x0 = BLADE_BACK - 3, x1 = PICK_ALONG + 3;
const W = (x1 - x0) * PX, H = 180, GROUND = 110;
const X = x => (x - x0) * PX;
const Y = h => GROUND - h * EX * PX;        // EX times the true height

/* Zones along the blade: sample the pitch finely, read where the contact is and what
   bladeZone calls it, and keep the runs. */
const runs = [];
for (let p = -MAX_BLADE_PITCH; p <= MAX_BLADE_PITCH + 1e-9; p += MAX_BLADE_PITCH / 400) {
  const a = contactAlong(p), z = bladeZone(p);
  const last = runs[runs.length - 1];
  if (last && last.z === z) last.b = a; else runs.push({ z, a, b: a });
}
const curve = (a, b) => {
  const n = 40, pts = [];
  for (let i = 0; i <= n; i++) { const x = a + (b - a) * i / n; pts.push(`${i ? 'L' : 'M'}${X(x).toFixed(1)} ${Y(sag(x)).toFixed(1)}`); }
  return pts.join(' ');
};
/* The outline: the running surface along the rocker, then the same circle continued
   past the front of the blade as far as the pick's deepest tooth, with the teeth cut
   into it. That is the model's own claim, drawn: tilt the foot forward far enough and
   the circle brings the pick to the ice. The top edge is flat at a height chosen for
   the picture, not measured. */
const TOP = Math.min(GROUND - 70, Y(sag(PICK_ALONG)) - 12);
const pickPts = [];
const NT = 4;
for (let i = 0; i <= NT * 2; i++) {
  const x = BLADE_FRONT + (PICK_ALONG - BLADE_FRONT) * i / (NT * 2);
  const inset = i % 2 ? 9 : 0;           // notches between the teeth
  const ang = Math.atan2(x, ROCKER - sag(x));
  pickPts.push(`L${(X(x) - inset * Math.sin(ang)).toFixed(1)} ${(Y(sag(x)) - inset * Math.cos(ang)).toFixed(1)}`);
}
const body = `M${X(BLADE_BACK - 1).toFixed(1)} ${TOP} L${X(BLADE_BACK).toFixed(1)} ${Y(sag(BLADE_BACK)).toFixed(1)} ` +
  `${curve(BLADE_BACK, BLADE_FRONT).replace(/^M/, 'L')} ${pickPts.join(' ')} ` +
  `L${X(PICK_ALONG + 1).toFixed(1)} ${TOP} Z`;
const SHORT = { heel: 'heel', 'behind centre': 'behind', 'middle of the blade': 'middle', 'forward of centre': 'forward', 'front of the blade': 'front' };
const mid = r => (r.a + r.b) / 2;
---
<figure class="kitfig">
  <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label={`A figure blade from the side: the rocker from heel to front, divided into ${runs.map(r => r.z).join(', ')}, with the toe pick beyond the front.`}>
    <line x1="0" x2={W} y1={GROUND} y2={GROUND} class="ice" />
    <path d={body} class="steel" />
    {runs.map((r, i) => <path d={curve(r.a, r.b)} class={`zone z${i % 2}`} />)}
    {runs.map((r, i) => (
      <text x={X(mid(r))} y={GROUND + (i % 2 ? 56 : 28)} text-anchor="middle">{SHORT[r.z] ?? r.z}</text>
    ))}
    <text x={X(PICK_ALONG) - 6} y={GROUND + 28} text-anchor="middle">pick</text>
  </svg>
  <figcaption>
    Heel on the left, toe on the right, height drawn {EX} times taller than it is. The
    blade is ground to a curve of about {Math.round(ROCKER / 30.48)} ft radius, so over its{' '}
    {BLADE_FRONT - BLADE_BACK} cm running length the ends stand only {(sag(BLADE_FRONT) * 10).toFixed(1)} mm above
    the lowest point. The names are the ones the guide's figures use for where the skater
    is standing.
  </figcaption>
</figure>
<style>
  .kitfig{margin:1.5rem 0;padding:1rem .9rem .2rem;background:var(--ice);border:1px solid var(--ice-line);border-radius:12px}
  .kitfig svg{display:block;width:100%;height:auto}
  .ice{stroke:var(--ice-line);stroke-width:2}
  .steel{fill:var(--ice-line);stroke:var(--ink-soft);stroke-width:1.5}
  .zone{fill:none;stroke-width:6;stroke-linecap:butt}
  .z0{stroke:var(--edge-out)}
  .z1{stroke:var(--edge-in)}
  text{font:21px ui-sans-serif,-apple-system,sans-serif;fill:var(--ink-soft)}
  figcaption{margin:.6rem 0 0;padding:.6rem .1rem .8rem;border-top:1px solid var(--ice-line);
    font-family:ui-sans-serif,-apple-system,sans-serif;font-size:.86rem;color:var(--ink-soft);line-height:1.5}
</style>
