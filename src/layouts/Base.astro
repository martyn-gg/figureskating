---
const { title, subtitle, kind } = Astro.props;
import { url } from '../lib/url.js';
import { BUILD_ID } from '../lib/build-id.js';
import { tokenCSS } from '../lib/tokens.js';
import { notebookCSS, TABS, tabFor } from '../lib/notebook.js';
import { COUNTRIES, countryOf, curl, localised, splitPath } from '../lib/country.js';
import { CONTACT, DONATE } from '../lib/site.js';
/* The version travels in the query string so the browser sees a byte-different
   worker on every deploy and reinstalls it, and so the worker can name its cache
   after the build it belongs to. */
const swPath = `${url('sw.js')}?v=${BUILD_ID}`;

/* THE FOOTER NOTATION, AND THE ONE PAGE THAT NO LONGER NEEDS IT.

   Everywhere else this is the only place a reader who arrived mid-guide — from a
   search result, from a coach's link, from a page about a bracket — is told how to
   read LFO at all. The front page now teaches it directly, above the fold, with the
   eight edges drawn beside it, so there it is the same sentence twice within a
   screen of itself. Compared against `url()` rather than a literal '/', because the
   root moves with the base path and this file must not carry its own copy of it. */
const slash = p => (p.endsWith('/') ? p : p + '/');
const isHome = slash(Astro.url.pathname) === slash(url());
const scope = url();
/* Never in development. A cache-first worker on localhost will happily serve a
   page you wrote three hours ago and give no sign that it is doing so. */
const useSW = import.meta.env.PROD;
/* The notebook's index tab for this page, if it has one. Element pages pass their
   kind; section, grade and test pages are worked out from the path. */
const tab = tabFor(Astro.url.pathname, kind);
/* THE COUNTRY THIS PAGE BELONGS TO, read off its path: /us/elements/lfo/ is the
   USA's copy of /elements/lfo/. Links in the layout go through `curl`, so the nav
   on a country page stays in that country. See src/lib/country.js. */
const { cc, rest } = splitPath(Astro.url.pathname);
const here = countryOf(cc);
const hasCopies = localised(rest);
const nav = p => curl(cc, p);
/* Where each choice in the selector goes: this page's own copy in that country
   where it has one, that country's front page where it does not. */
const choices = [
  /* The 404 page is built at /404.html but served at whatever path was missing,
     so its own path is no place to send anyone. */
  { id: 'all', label: 'All countries', href: /^404/.test(rest) ? url() : url(rest) },
  ...COUNTRIES.map(c => ({ id: c.id, label: c.short, href: hasCopies ? url(`${c.id}/${rest}`) : url(`${c.id}/`) })),
];
/* The same page in the other copies, for search engines. The root is x-default,
   because it is the guide for every country at once. */
const alternates = hasCopies ? [
  { lang: 'x-default', href: new URL(url(rest), Astro.site).href },
  ...COUNTRIES.map(c => ({ lang: c.lang, href: new URL(url(`${c.id}/${rest}`), Astro.site).href })),
] : [];
---
<!DOCTYPE html>
<html lang="en-GB">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title ? `${title} · Field Guide to Figure Skating` : 'Field Guide to Figure Skating'}</title>
  <meta name="description" content={subtitle ?? 'A reference to figure skating elements and the national tests they appear in.'} />
  <link rel="manifest" href={url('manifest.webmanifest')} />
  <meta name="theme-color" content="#12303f" />
  {/* SVG first for browsers that take it, the 192 as the fallback, and the Apple
      one separately because iOS ignores the manifest's icons entirely. All four
      are generated by tools/icons.mjs from the palette. */}
  <link rel="icon" href={url('icon.svg')} type="image/svg+xml" />
  <link rel="icon" href={url('icon-192.png')} sizes="192x192" type="image/png" />
  <link rel="apple-touch-icon" href={url('apple-touch-icon.png')} />
  {/* Canonical, because the same page is reachable at the apex and at www until
      GitHub's redirect settles, and search engines should be in no doubt. */}
  <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site).href} />
  {alternates.map(a => <link rel="alternate" hreflang={a.lang} href={a.href} />)}
  {/* The palette comes out of src/lib/tokens.js, which tools/contrast.mjs also
      imports and measures. Colours are not written here any more — a hex code in
      this file would be a second source of truth and the checker would not see it. */}
  <style is:inline set:html={tokenCSS()}></style>
  {/* The notebook look, generated by src/lib/notebook.js and scoped so that
      data-theme="formal" switches every rule of it off. */}
  <style is:inline set:html={notebookCSS(url())}></style>
  {/* Applied before first paint, so a reader who chose a scheme does not get a
      flash of the other one. Inline and synchronous for that reason. */}
  <script is:inline>
    try {
      var s = localStorage.getItem('scheme');
      if (s === 'light' || s === 'dark') document.documentElement.dataset.scheme = s;
      if (localStorage.getItem('theme') === 'formal') document.documentElement.dataset.theme = 'formal';
    } catch (e) {}
  </script>
  {/* A reader who chose a country and lands on the root copy of a page that has a
      country copy is taken to theirs. Only on an explicit choice made in the
      selector, never from having followed a link to a country page, and "All
      countries" clears it. Replace, so the back button does not bounce. */}
  {!cc && hasCopies && (
    <script is:inline define:vars={{ countries: COUNTRIES.map(c => c.id), base: url() }}>
      try {
        var c = localStorage.getItem('country');
        if (countries.indexOf(c) >= 0) {
          var rest = location.pathname.slice(base.length);
          location.replace(base + c + '/' + rest + location.search + location.hash);
        }
      } catch (e) {}
    </script>
  )}
  <style is:global>
    *{box-sizing:border-box} html,body{margin:0}
    /* A class that sets display must not undo the hidden attribute. */
    [hidden]{display:none!important}
    body{background:var(--paper);color:var(--ink);line-height:1.6;
      font:17px/1.6 ui-serif,Georgia,'Times New Roman',serif;-webkit-font-smoothing:antialiased}
    .wrap{max-width:44rem;margin:0 auto;padding:2rem 1.25rem 5rem}
    h1,h2,h3,nav,.meta,.chip,footer{font-family:ui-sans-serif,-apple-system,'Segoe UI',Roboto,sans-serif}
    h1{font-size:1.9rem;letter-spacing:-.02em;margin:0 0 .3rem;line-height:1.2}
    h2{font-size:.78rem;letter-spacing:.09em;text-transform:uppercase;color:var(--ink-soft);
      margin:2.5rem 0 .75rem;font-weight:600}
    a{color:var(--accent)}
    a:hover{color:var(--accent);text-decoration-thickness:2px}
    /* Nav is a row of links used one-handed in gloves, so the row is laid out with
       a gap and each link is given a 44 px height rather than a text baseline. */
    nav{font-size:.85rem;margin-bottom:2rem;padding-bottom:.35rem;border-bottom:1px solid var(--rule);
      display:flex;flex-wrap:wrap;gap:0 1.1rem}
    nav a{text-decoration:none;padding:.6rem 0;min-height:44px;display:flex;align-items:center}
    /* The scheme switch is the one control in the nav rather than a link, so it is
       pushed to the end of the row and given the same 44 px as everything else
       that gets operated in gloves. It states the scheme it will switch TO. */
    nav .scheme{margin-left:auto;min-height:44px;padding:.6rem .8rem;border:1px solid var(--rule);
      border-radius:999px;background:none;color:var(--accent);cursor:pointer;font:inherit;
      display:flex;align-items:center;gap:.4rem}
    nav .scheme:hover{border-color:var(--accent)}
    /* The country selector sits just before the scheme switch and pushes both to
       the end of the row; the scheme switch then no longer needs its own margin. */
    nav .country{margin-left:auto;position:relative}
    nav .country+.scheme{margin-left:.5rem}
    nav .country summary{list-style:none;min-height:44px;padding:.6rem .8rem;border:1px solid var(--rule);
      border-radius:999px;color:var(--accent);cursor:pointer;display:flex;align-items:center;gap:.35rem}
    nav .country summary::-webkit-details-marker{display:none}
    nav .country summary::after{content:"";width:.4rem;height:.4rem;border:solid currentColor;
      border-width:0 1.5px 1.5px 0;transform:rotate(45deg) translateY(-2px)}
    nav .country ul{position:absolute;right:0;top:calc(100% + .3rem);z-index:5;list-style:none;margin:0;
      padding:.3rem .9rem;background:var(--paper);border:1px solid var(--ice-line);border-radius:10px;
      box-shadow:0 4px 14px rgba(0,0,0,.12);min-width:11rem}
    nav .country a[aria-current]{font-weight:700;color:var(--ink)}
    .lede{color:var(--ink-soft);margin:0 0 1.5rem;font-size:1.05rem}
    /* Other names for the same movement. Sits under the lede rather than in the
       meta row, because it is prose a reader needs to see, not a chip. */
    .aka{margin:-1rem 0 1.5rem;color:var(--ink-soft);font-size:.95rem}
    .aka b{font-weight:600;color:var(--ink)}
    .meta{display:flex;flex-wrap:wrap;gap:.4rem;margin:0 0 1.5rem;font-size:.82rem}
    .chip{background:var(--ice);border:1px solid var(--ice-line);border-radius:999px;
      padding:.28rem .72rem;color:var(--ink-soft)}
    .chip b{color:var(--ink);font-weight:600}
    .unverified{border:1px solid var(--warn);border-left-width:4px;border-radius:8px;
      padding:.8rem 1rem;margin:0 0 1.75rem;font-size:.88rem;
      font-family:ui-sans-serif,-apple-system,sans-serif;color:var(--ink-soft)}
    .unverified b{color:var(--warn)}
    ul.plain{list-style:none;padding:0}
    ul.plain li{padding:.55rem 0;border-bottom:1px solid var(--rule)}
    ul.plain a{text-decoration:none;font-weight:600}
    ul.plain span{color:var(--ink-soft);font-size:.9rem;display:block;font-family:ui-sans-serif,sans-serif}
    /* A JUMP'S TWO EDGES. The tracings are square and small on purpose: they are a
       reference to the two edges the jump lives between, not the instrument — the
       full EdgeDiagram is what a reader scrubs, and these sit at a size that says
       "look at the shape" rather than filling the column.

       They shipped once with no rule at all, which is how EdgeThumb's own
       `width:100%` got to be the only thing deciding their size and each one came
       out as wide as the page. Structure checks passed and would again; nothing
       short of looking at it catches a missing stylesheet rule. */
    .jumptrace{margin:1.75rem 0;padding:1rem .9rem .2rem;background:var(--ice);
      border:1px solid var(--ice-line);border-radius:12px}
    .jt-pair{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));
      gap:.9rem 1.4rem;max-width:21rem;margin:0 auto}
    .jt-pair>div{text-align:center;min-width:0}
    .jt-pair b{display:block;margin-top:.35rem;font-size:.95rem;letter-spacing:.01em}
    .jt-pair span{display:block;font-family:ui-sans-serif,-apple-system,sans-serif;
      font-size:.8rem;color:var(--ink-soft)}
    .jumptrace figcaption{margin:.9rem 0 0;padding:.7rem .1rem .8rem;
      border-top:1px solid var(--ice-line);
      font-family:ui-sans-serif,-apple-system,sans-serif;font-size:.86rem;
      color:var(--ink-soft);line-height:1.5}
    @media (max-width:420px){ .jt-pair{max-width:17rem;gap:.7rem 1rem} }

    .derived{background:var(--ice);border:1px solid var(--ice-line);border-radius:10px;
      padding:1rem 1.15rem;font-size:.92rem}
    .derived p{margin:0 0 .5rem} .derived p:last-child{margin:0}
.bf{margin:1.75rem 0}
  .bf-views{display:grid;gap:.7rem}
  .bf-pair{display:grid;grid-template-columns:1fr 1fr;gap:.7rem}
  @media (max-width:34rem){.bf-pair{grid-template-columns:1fr}}
  .bf-card{background:var(--ice);border:1px solid var(--ice-line);border-radius:12px;overflow:hidden}
  .bf-card h3{margin:0;padding:.5rem .8rem .45rem;font-size:.66rem;letter-spacing:.09em;
    text-transform:uppercase;color:var(--ink-soft);font-weight:600;border-bottom:1px solid var(--ice-line);
    font-family:ui-sans-serif,-apple-system,sans-serif}
  .bf-card h3 span{text-transform:none;letter-spacing:0;font-weight:400;opacity:.75}
  .bf-card svg{display:block;width:100%;height:auto}
  .bf-ctl{display:flex;align-items:center;gap:.6rem;margin-top:.7rem;padding:.5rem .7rem;
    background:var(--ice);border:1px solid var(--ice-line);border-radius:12px}
  /* 44 px, because this is operated in gloves. It was 32. */
  .bf-ctl button{width:44px;height:44px;flex:none;border-radius:999px;border:1px solid var(--ice-line);
    background:var(--paper);color:var(--ink);cursor:pointer;font-size:13px}
  /* The speed control carries a label rather than a glyph, so it sets its own width,
     and marks itself once the rig is no longer running at full speed. */
  .bf-ctl button.spd{width:auto;min-width:44px;padding:0 .6rem;font-size:.86rem;
    font-family:ui-sans-serif,-apple-system,sans-serif;font-variant-numeric:tabular-nums}
  .bf-ctl button.spd[data-slow]{border-color:var(--accent);color:var(--accent)}
  .bf-ctl input[type=range]{flex:1;accent-color:var(--accent);min-width:0;height:44px}
  .bf-phase{margin:.45rem 0 0;font-size:.82rem;color:var(--ink-soft);
    font-family:ui-sans-serif,-apple-system,sans-serif}
  .bf figcaption{margin-top:.6rem;font-family:ui-sans-serif,-apple-system,sans-serif;
    font-size:.82rem;color:var(--ink-soft)}
  .bf-twist{display:inline-block;background:var(--ice);border:1px solid var(--ice-line);
    border-radius:999px;padding:.15rem .6rem;margin-right:.4rem}
  .bf-twist b{color:var(--ink);font-variant-numeric:tabular-nums}
    /* Live values sit in their own fixed row, never inline with prose. A number
       that reflows the paragraph beside it is unreadable however correct it is. */
    .bf-phase{min-height:2.7em;margin:.45rem 0 0}
    .bf-readouts{display:grid;grid-template-columns:13rem 1fr;gap:.3rem 1rem;margin:.5rem 0 .1rem;
      font-family:ui-sans-serif,-apple-system,sans-serif;font-size:.82rem;color:var(--ink-soft)}
    @media (max-width:26rem){.bf-readouts{grid-template-columns:1fr}}
    .bf-readouts span{background:var(--ice);border:1px solid var(--ice-line);border-radius:999px;
      padding:.2rem .7rem;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
    .bf-readouts b{color:var(--ink);font-variant-numeric:tabular-nums}

    .derived p.notation{padding-bottom:.6rem;margin-bottom:.7rem;border-bottom:1px solid var(--ice-line)}
    footer{margin-top:4rem;padding-top:1.25rem;border-top:1px solid var(--rule);
      color:var(--ink-soft);font-size:.82rem}
    /* Same 44 px target as the nav — the footer links are the ones a coach taps
       on a phone at the side of the ice, in gloves, having just spotted an error. */
    .foot-links{display:flex;flex-wrap:wrap;gap:0 1.1rem;margin:.9rem 0 0}
    .foot-links a{text-decoration:none;min-height:44px;display:flex;align-items:center}
    /* The look switch, notebook or textbook: a pill like the scheme switch in
       the nav, with the same 44 px. */
    .theme{min-height:44px;padding:.6rem .9rem;margin:.6rem 0 0;border:1px solid var(--rule);border-radius:999px;
      background:none;color:var(--accent);cursor:pointer;font:inherit}
    /* The notebook's index tabs. Hidden here; src/lib/notebook.js shows them. */
    .tabs{display:none;position:absolute;right:0;top:7.5rem;flex-direction:column;gap:6px}
    @media print{.tabs{display:none!important}}
    /* A reader's own ticks, kept on their phone. Hidden until the script has
       wired them up, so a reader without JavaScript never sees a box that does
       nothing. */
    .can{display:flex;align-items:center;gap:.55rem;min-height:44px;margin:-.6rem 0 1.2rem;cursor:pointer}
    .can input,.tick input{width:22px;height:22px;flex:none;accent-color:var(--accent);margin:0;cursor:pointer}
    :root:not([data-theme="formal"]) .can{font-family:Caveat,cursive;font-size:1.35rem}
  </style>
</head>
<body>
  <div class="wrap">
    <nav>
      <a href={nav('')}>Field Guide</a>
      <a href={nav('elements/')}>Elements</a>
      <a href={nav('tests/')}>Tests</a>
      <a href={nav('grades/')}>Grades</a>
      <a href={nav('rig/')}>Body frame</a>
      <a href={nav('search/')}>Search</a>
      {/* The country selector. Plain links in a disclosure, so it works with no
          script; the script only remembers the choice. */}
      <details class="country">
        <summary aria-label={`Country: ${here ? here.short : 'all countries'}. Change`}>{here ? here.code : 'World'}</summary>
        <ul>
          {choices.map(c => (
            <li><a href={c.href} data-cc={c.id} aria-current={(c.id === (cc ?? 'all')) ? 'true' : undefined}>{c.label}</a></li>
          ))}
        </ul>
      </details>
      <button class="scheme" type="button" aria-live="polite">Dark</button>
    </nav>
    <aside class="tabs" aria-label="Sections">
      {TABS.map(t => <a class={`t-${t.id}`} href={nav(t.href)} aria-current={t.id === tab ? 'true' : undefined}>{t.label}</a>)}
    </aside>
    <slot />
    <footer>
      {!isHome && <>
        Edges are written as three letters: foot, direction, edge. <b>LFO</b> is a left
        foot travelling forwards on an outside edge; <b>RBI</b> is a right foot backwards
        on an inside edge.
        <br /><br />
      </>}
      Written and drawn from scratch. No governing body's material is reproduced.
      Mechanics are unverified unless a page says otherwise.
      <p class="foot-links">
        <a href={url('about/')}>About</a>
        <a href={url('coaches/')}>For coaches</a>
        <a href={`mailto:${CONTACT}`}>Corrections</a>
        {/* Rendered only once there is somewhere for it to go. A donate button
            that 404s asks for money and loses the reader in one click. */}
        {DONATE && <a href={DONATE}>Buy a coffee</a>}
      </p>
      <button class="theme" type="button" hidden>Show as a textbook</button>
    </footer>
  </div>
  <script is:inline>
    /* The label names the destination, not the current state, and is corrected on
       load because the starting scheme may have come from the OS rather than from
       a stored choice. */
    (() => {
      const root = document.documentElement, btn = document.querySelector('nav .scheme');
      if (!btn) return;
      const dark = () => root.dataset.scheme
        ? root.dataset.scheme === 'dark'
        : matchMedia('(prefers-color-scheme:dark)').matches;
      const label = () => {
        btn.textContent = dark() ? 'Light' : 'Dark';
        btn.setAttribute('aria-label', `Switch to the ${dark() ? 'light' : 'dark'} scheme`);
      };
      btn.addEventListener('click', () => {
        const next = dark() ? 'light' : 'dark';
        root.dataset.scheme = next;
        try { localStorage.setItem('scheme', next); } catch (e) {}
        label();
      });
      /* Only tracks the OS while the reader has not chosen for themselves. */
      matchMedia('(prefers-color-scheme:dark)').addEventListener('change', () => {
        if (!root.dataset.scheme) label();
      });
      label();
    })();
  </script>
  <script is:inline>
    /* The country choice is remembered only when a reader makes one: the
       selector, or a link that names a country and is marked as a choice. */
    document.querySelectorAll('a[data-cc]').forEach(a => a.addEventListener('click', () => {
      try { a.dataset.cc === 'all' ? localStorage.removeItem('country') : localStorage.setItem('country', a.dataset.cc); } catch (e) {}
    }));
    /* Notebook or textbook. The label names the look it switches TO. */
    (() => {
      const root = document.documentElement, btn = document.querySelector('footer .theme');
      if (!btn) return;
      const label = () => { btn.textContent = root.dataset.theme === 'formal' ? 'Show as a notebook' : 'Show as a textbook'; };
      btn.addEventListener('click', () => {
        const formal = root.dataset.theme !== 'formal';
        if (formal) root.dataset.theme = 'formal'; else delete root.dataset.theme;
        try { formal ? localStorage.setItem('theme', 'formal') : localStorage.removeItem('theme'); } catch (e) {}
        label();
      });
      label(); btn.hidden = false;
    })();
    /* A reader's own ticks: "I can do this" on an element, and each line of a
       grade. Kept in this browser only; nothing is sent anywhere. */
    (() => {
      let store;
      try { store = window.localStorage; store.getItem('x'); } catch (e) { return; }
      const boxes = document.querySelectorAll('input[data-tick]');
      const meters = document.querySelectorAll('[data-tally]');
      const tally = () => meters.forEach(m => {
        const scope = document.querySelectorAll(`input[data-tick^="${m.dataset.tally}"]`);
        const done = [...scope].filter(b => b.checked).length;
        const bar = m.querySelector('i'), txt = m.querySelector('span');
        if (bar) bar.style.width = `${scope.length ? (100 * done / scope.length) : 0}%`;
        if (txt) txt.textContent = `${done} of ${scope.length} ticked`;
        m.hidden = false;
      });
      boxes.forEach(b => {
        const key = `tick:${b.dataset.tick}`;
        b.checked = store.getItem(key) === '1';
        b.addEventListener('change', () => {
          try { b.checked ? store.setItem(key, '1') : store.removeItem(key); } catch (e) {}
          tally();
        });
        b.closest('[hidden]')?.removeAttribute('hidden');
      });
      tally();
    })();
  </script>
  <script is:inline define:vars={{ swPath, scope, useSW }}>
    if ('serviceWorker' in navigator) {
      if (useSW) {
        window.addEventListener('load', () => navigator.serviceWorker.register(swPath, { scope }).catch(() => {}));
      } else {
        /* Clean up after anyone who ran an older build locally — otherwise the
           worker registered then keeps serving that build for ever. */
        navigator.serviceWorker.getRegistrations()
          .then(rs => rs.forEach(r => r.unregister()))
          .then(() => caches?.keys().then(ks => ks.forEach(k => caches.delete(k))))
          .catch(() => {});
      }
    }
  </script>
</body>
</html>
