---
const { title, subtitle } = Astro.props;
import { url } from '../lib/url.js';
import { BUILD_ID } from '../lib/build-id.js';
/* The version travels in the query string so the browser sees a byte-different
   worker on every deploy and reinstalls it, and so the worker can name its cache
   after the build it belongs to. */
const swPath = `${url('sw.js')}?v=${BUILD_ID}`;
const scope = url();
/* Never in development. A cache-first worker on localhost will happily serve a
   page you wrote three hours ago and give no sign that it is doing so. */
const useSW = import.meta.env.PROD;
---
<!DOCTYPE html>
<html lang="en-GB">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title ? `${title} · Field Guide to Figure Skating` : 'Field Guide to Figure Skating'}</title>
  <meta name="description" content={subtitle ?? 'A reference to figure skating elements and the national tests they appear in.'} />
  <link rel="manifest" href={url('manifest.webmanifest')} />
  <meta name="theme-color" content="#12303f" />
  <style is:global>
    :root{--ice:#f2f7fb;--ice-line:#d5e3ee;--ink:#12303f;--ink-soft:#5a7386;
      --paper:#fff;--rule:#dfe8ef;--accent:#1d5a7a;--edge-out:#0f766e;--edge-in:#b45309;--warn:#b45309;
      /* body-frame rig */
      --hip:#7c3aed;--shoulder:#0369a1;--free:#94a3b8;--leg-l:#e11d48;--leg-r:#4d7c0f}
    @media (prefers-color-scheme:dark){:root{--ice:#101c24;--ice-line:#20353f;--ink:#e6f0f5;
      --ink-soft:#8ba6b5;--paper:#0b141a;--rule:#1e3038;--accent:#7fc4e3;
      --edge-out:#5eead4;--edge-in:#fbbf24;--warn:#fbbf24;
      --hip:#c4b5fd;--shoulder:#7dd3fc;--free:#64748b;--leg-l:#fb7185;--leg-r:#a3e635}}
    *{box-sizing:border-box} html,body{margin:0}
    body{background:var(--paper);color:var(--ink);line-height:1.6;
      font:17px/1.6 ui-serif,Georgia,'Times New Roman',serif;-webkit-font-smoothing:antialiased}
    .wrap{max-width:44rem;margin:0 auto;padding:2rem 1.25rem 5rem}
    h1,h2,h3,nav,.meta,.chip,footer{font-family:ui-sans-serif,-apple-system,'Segoe UI',Roboto,sans-serif}
    h1{font-size:1.9rem;letter-spacing:-.02em;margin:0 0 .3rem;line-height:1.2}
    h2{font-size:.78rem;letter-spacing:.09em;text-transform:uppercase;color:var(--ink-soft);
      margin:2.5rem 0 .75rem;font-weight:600}
    a{color:var(--accent)}
    nav{font-size:.85rem;margin-bottom:2rem;padding-bottom:1rem;border-bottom:1px solid var(--rule)}
    nav a{margin-right:1.1rem;text-decoration:none}
    .lede{color:var(--ink-soft);margin:0 0 1.5rem;font-size:1.05rem}
    .meta{display:flex;flex-wrap:wrap;gap:.4rem;margin:0 0 1.5rem;font-size:.8rem}
    .chip{background:var(--ice);border:1px solid var(--ice-line);border-radius:999px;
      padding:.25rem .7rem;color:var(--ink-soft)}
    .chip b{color:var(--ink);font-weight:600}
    .unverified{border:1px solid var(--warn);border-left-width:4px;border-radius:8px;
      padding:.8rem 1rem;margin:0 0 1.75rem;font-size:.88rem;
      font-family:ui-sans-serif,-apple-system,sans-serif;color:var(--ink-soft)}
    .unverified b{color:var(--warn)}
    ul.plain{list-style:none;padding:0}
    ul.plain li{padding:.55rem 0;border-bottom:1px solid var(--rule)}
    ul.plain a{text-decoration:none;font-weight:600}
    ul.plain span{color:var(--ink-soft);font-size:.9rem;display:block;font-family:ui-sans-serif,sans-serif}
    .derived{background:var(--ice);border:1px solid var(--ice-line);border-radius:10px;
      padding:1rem 1.15rem;font-size:.92rem}
    .derived p{margin:0 0 .5rem} .derived p:last-child{margin:0}
.bf{margin:1.75rem 0}
  .bf-views{display:grid;gap:.7rem}
  .bf-pair{display:grid;grid-template-columns:1fr 1fr;gap:.7rem}
  @media (max-width:34rem){.bf-pair{grid-template-columns:1fr}}
  .bf-card{background:var(--ice);border:1px solid var(--ice-line);border-radius:12px;overflow:hidden}
  .bf-card h3{margin:0;padding:.5rem .8rem .45rem;font-size:.66rem;letter-spacing:.09em;
    text-transform:uppercase;color:var(--ink-soft);font-weight:600;border-bottom:1px solid var(--ice-line);
    font-family:ui-sans-serif,-apple-system,sans-serif}
  .bf-card h3 span{text-transform:none;letter-spacing:0;font-weight:400;opacity:.75}
  .bf-card svg{display:block;width:100%;height:auto}
  .bf-ctl{display:flex;align-items:center;gap:.7rem;margin-top:.7rem;padding:.55rem .8rem;
    background:var(--ice);border:1px solid var(--ice-line);border-radius:12px}
  .bf-ctl button{width:32px;height:32px;flex:none;border-radius:999px;border:1px solid var(--ice-line);
    background:var(--paper);color:var(--ink);cursor:pointer;font-size:11px}
  /* The speed control carries a label rather than a glyph, so it sets its own width,
     and marks itself once the rig is no longer running at full speed. */
  .bf-ctl button.spd{width:auto;min-width:38px;padding:0 .5rem;font-size:.78rem;
    font-family:ui-sans-serif,-apple-system,sans-serif;font-variant-numeric:tabular-nums}
  .bf-ctl button.spd[data-slow]{border-color:var(--accent);color:var(--accent)}
  .bf-ctl input[type=range]{flex:1;accent-color:var(--accent);min-width:0}
  .bf-phase{margin:.45rem 0 0;font-size:.8rem;color:var(--ink-soft);
    font-family:ui-sans-serif,-apple-system,sans-serif}
  .bf figcaption{margin-top:.6rem;font-family:ui-sans-serif,-apple-system,sans-serif;
    font-size:.82rem;color:var(--ink-soft)}
  .bf-twist{display:inline-block;background:var(--ice);border:1px solid var(--ice-line);
    border-radius:999px;padding:.15rem .6rem;margin-right:.4rem}
  .bf-twist b{color:var(--ink);font-variant-numeric:tabular-nums}
    /* Live values sit in their own fixed row, never inline with prose. A number
       that reflows the paragraph beside it is unreadable however correct it is. */
    .bf-phase{min-height:2.7em;margin:.45rem 0 0}
    .bf-readouts{display:grid;grid-template-columns:13rem 1fr;gap:.3rem 1rem;margin:.5rem 0 .1rem;
      font-family:ui-sans-serif,-apple-system,sans-serif;font-size:.82rem;color:var(--ink-soft)}
    @media (max-width:26rem){.bf-readouts{grid-template-columns:1fr}}
    .bf-readouts span{background:var(--ice);border:1px solid var(--ice-line);border-radius:999px;
      padding:.2rem .7rem;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
    .bf-readouts b{color:var(--ink);font-variant-numeric:tabular-nums}

    .derived p.notation{padding-bottom:.6rem;margin-bottom:.7rem;border-bottom:1px solid var(--ice-line)}
    footer{margin-top:4rem;padding-top:1.25rem;border-top:1px solid var(--rule);
      color:var(--ink-soft);font-size:.82rem}
  </style>
</head>
<body>
  <div class="wrap">
    <nav>
      <a href={url()}>Field Guide</a>
      <a href={url('elements/')}>Elements</a>
      <a href={url('tests/')}>Tests</a>
      <a href={url('rig/')}>Body frame</a>
    </nav>
    <slot />
    <footer>
      Edges are written as three letters — foot, direction, edge. <b>LFO</b> is a left
      foot travelling forwards on an outside edge; <b>RBI</b> is a right foot backwards
      on an inside edge.
      <br /><br />
      Written and drawn from scratch — no governing body's material is reproduced.
      Mechanics are unverified unless a page says otherwise.
    </footer>
  </div>
  <script is:inline define:vars={{ swPath, scope, useSW }}>
    if ('serviceWorker' in navigator) {
      if (useSW) {
        window.addEventListener('load', () => navigator.serviceWorker.register(swPath, { scope }).catch(() => {}));
      } else {
        /* Clean up after anyone who ran an older build locally — otherwise the
           worker registered then keeps serving that build for ever. */
        navigator.serviceWorker.getRegistrations()
          .then(rs => rs.forEach(r => r.unregister()))
          .then(() => caches?.keys().then(ks => ks.forEach(k => caches.delete(k))))
          .catch(() => {});
      }
    }
  </script>
</body>
</html>
