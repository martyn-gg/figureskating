---
/* THE ELEMENTS HUB — 19/09/2026, Martyn: the elements page is a long wall of links.

   It was. 149 KB and 306 links in nine sections, which is the wrong thing to hand
   someone on a phone, in gloves, at a rink between run-throughs — the reader
   docs/style.md describes and the one the whole guide is written for. The contents
   strip added on 30/08 made the bottom of it one tap away, which treated the symptom.

   So this page is now nine cards and nothing else, and each section is its own page
   at /elements/in/<section>/. The cards are derived from the same SECTIONS list the
   sections themselves are, so a kind added tomorrow appears here without anyone
   remembering to add it — which is the property the old contents strip had and the
   reason it is kept rather than hand-written. */
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { url } from '../../lib/url.js';
import { elementGroups, SECTION_NOTE } from '../../lib/element-groups.js';

const elements = await getCollection('elements');
const { SECTIONS, nEdges, nTurns, transitions, combos } = elementGroups(elements);
---
<Base title="Elements" subtitle="Every plain edge, turn, transition and cluster, on both feet.">
  <h1>Elements</h1>
  <p class="lede">
    {elements.length} elements in {SECTIONS.length} groups — the geometry of every one of
    them derived rather than drawn. Each element exists once and knows nothing about tests,
    so it can appear in as many as it likes.
  </p>

  <ul class="plain cards">
    {SECTIONS.map(sec => (
      <li>
        <a href={url(`elements/in/${sec.id}/`)}>{sec.label}<b>{sec.n}</b></a>
        <span>{SECTION_NOTE[sec.id]}</span>
      </li>
    ))}
  </ul>
</Base>

<style>
  .cards a{display:flex;align-items:baseline;gap:.6rem;font-weight:600}
  .cards a b{font-weight:600;opacity:.6;font-variant-numeric:tabular-nums}
</style>
