---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import { url } from '../lib/url.js';
const elements = await getCollection('elements');
const tests = await getCollection('tests');
const byKind = k => elements.filter(e => e.data.kind === k);
const featured = elements
  .filter(e => !['edge', 'turn', 'combination'].includes(e.data.kind))
  .sort((a, b) => a.data.name.localeCompare(b.data.name));
---
<Base title={null}>
  <h1>Field Guide to Figure Skating</h1>
  <p class="lede">
    Edges, turns, jumps, spins and positions — with the national tests each one appears in.
    Built so it works at the rink with no signal.
  </p>

  <h2>Start here</h2>
  <ul class="plain">
    <li>
      <a href={url('elements/')}>Edges and turns</a>
      <span>
        {byKind('edge').length} edges, {byKind('turn').length} turns and
        {byKind('combination').length} clusters, on both feet
      </span>
    </li>
    <li>
      <a href={url('tests/')}>Tests</a>
      <span>which syllabus each element belongs to — {tests.length} recorded so far</span>
    </li>
    <li>
      <a href={url('rig/')}>Body frame</a>
      <span>one rig, three views, one clock — what the rest of the body is doing</span>
    </li>
  </ul>

  <h2>Mechanics</h2>
  <ul class="plain">
    {featured.map(e => (
      <li>
        <a href={url(`elements/${e.id}/`)}>{e.data.name}</a>
        <span>{e.data.summary}</span>
      </li>
    ))}
  </ul>

  <h2>How it is built</h2>
  <div class="derived">
    <p>
      Almost nothing here is drawn or written per element. Which way a lobe curves is a
      product of three facts about the foot — which foot, which edge, forwards or backwards —
      so the guide stores those three and derives the rest.
    </p>
    <p>
      That is why every element mirrors for free: flip the foot and you have the version for
      a skater who rotates the other way, which almost no other resource provides.
    </p>
  </div>

  <p style="margin-top:1.5rem;font-size:.9rem;color:var(--ink-soft)">
    {elements.length} elements recorded — {byKind('edge').length} edges,
    {byKind('turn').length} turns, {byKind('combination').length} clusters,
    {byKind('jump').length} jumps, {byKind('position').length} positions.
    None of it checked by a coach yet.
  </p>
</Base>
