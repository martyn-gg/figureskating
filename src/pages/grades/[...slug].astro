---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Unverified from '../../components/Unverified.astro';
import { url } from '../../lib/url.js';

export async function getStaticPaths() {
  const grades = await getCollection('grades');
  return grades.map(g => ({ params: { slug: g.id }, props: { entry: g } }));
}
const { entry } = Astro.props;
const d = entry.data;
const { Content } = await render(entry);
const all = await getCollection('elements');
const el = id => all.find(e => e.id === id);
const slug = s => s.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '');
const key = (l, k) => `grade:${entry.id}:${slug(l.name)}:${k}`;
---
<Base title={d.name} subtitle={d.summary} crumbs={[{ name: 'Grades', href: url('grades/') }, { name: d.name }]}>
  <p class="lede"><a href={url('grades/')}>Grades by country</a> · {d.country}</p>
  <h1>{d.name}</h1>
  <div class="meta"><span class="chip">{d.body}</span><span class="chip">{d.levels.length} level{d.levels.length === 1 ? '' : 's'}</span></div>
  {/* The reader's progress through this programme, from their own ticks below.
      Filled in and unhidden by the script in Base.astro. */}
  <p class="tally" data-tally={`grade:${entry.id}:`} hidden><b><i></i></b> <span></span></p>
  <Unverified verified={d.verified} what="level lists" title={d.name} />
  <Content />

  {d.levels.map(l => (
    <>
      <h2 id={slug(l.name)}>{l.name}</h2>
      {l.aka.length > 0 && <p class="note">Now called {l.aka.join(' and ')}.</p>}
      {l.note && <p class="note">{l.note}</p>}
      <ul class="grade">
        {l.items.map((i, k) => (
          <li>
            <label class="box" hidden><input type="checkbox" data-tick={key(l, k)} aria-label={`Ticked: ${i.label}`} /></label>
            <div>
            <span class="label">{i.page ? <a href={url(i.page)}>{i.label}</a> : i.label}</span>{' '}
            {i.elements.length > 0 && (
              <span class="to">{i.elements.map((r, k) => <>{k > 0 ? ', ' : ''}<a href={url(`elements/${r.id}/`)}>{el(r.id)?.data.name ?? r.id}</a></>)}</span>
            )}{' '}
            {i.note && <span class="gap">{i.note}</span>}
            </div>
          </li>
        ))}
      </ul>
    </>
  ))}

  <p class="src">Source: <a href={d.sourceUrl}>{d.source}</a></p>
</Base>

<style>
  .note{color:var(--ink-soft);font-size:.9rem;margin:.2rem 0 .6rem}
  .grade{list-style:none;padding:0;margin:0 0 1.4rem}
  .grade li{padding:.5rem 0;border-bottom:1px solid var(--rule);display:flex;gap:.7rem;align-items:flex-start}
  .grade li>div{min-width:0}
  /* 22 px drawn, 44 px to hit: the label round the box is the target. */
  .grade .box{display:flex;align-items:center;justify-content:center;width:44px;height:44px;flex:none;
    margin:-.45rem -.35rem 0 -.6rem;cursor:pointer}
  .grade input{width:22px;height:22px;margin:0;accent-color:var(--accent);cursor:pointer}
  .grade li:has(input:checked) .label{text-decoration:line-through;text-decoration-color:var(--accent)}
  .tally{display:flex;align-items:center;gap:.8rem;margin:0 0 1.4rem;color:var(--ink-soft);font-size:.95rem}
  .tally b{flex:1;max-width:16rem;height:12px;border:1.5px solid var(--ink);border-radius:6px;overflow:hidden}
  .tally i{display:block;height:100%;width:0;background:repeating-linear-gradient(-45deg,var(--accent) 0 3px,transparent 3px 7px)}
  .grade .label{display:block;font-weight:600}
  .grade .to,.grade .gap{display:block;font-size:.9rem;font-family:ui-sans-serif,sans-serif}
  .grade .to a{text-decoration:none}
  .grade .gap{color:var(--ink-soft)}
  .src{font-size:.85rem;margin-top:1.5rem;color:var(--ink-soft)}
</style>
