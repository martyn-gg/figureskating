---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import EdgeThumb from '../../components/EdgeThumb.astro';
import EdgeDiagram from '../../components/EdgeDiagram.astro';
import { curl, COPIES, COUNTRIES, countryOf } from '../../lib/country.js';
import { label } from '../../lib/skating.js';

/* One copy per country and one for the root: see src/lib/country.js. */
export function getStaticPaths() { return COPIES.map(cc => ({ params: { cc } })); }
const { cc } = Astro.params;
const url = p => curl(cc, p);
const elements = await getCollection('elements');
const tests = await getCollection('tests');
const byKind = k => elements.filter(e => e.data.kind === k);
/* On a country copy the front page names that country's programmes and lists
   them; the root names all four countries and offers the copies. */
const here = countryOf(cc);
const myGrades = here
  ? (await getCollection('grades')).filter(g => g.data.country === here.grades)
      .sort((a, b) => a.data.order - b.data.order)
  : [];

/* Name the kinds this page counts rather than the kinds it hides. The old line
   listed the exclusions, so the twenty-four twizzles added on 29/08/2026 fell
   through it and landed alphabetically in amongst the jumps — a new kind should
   not be able to appear here by not having been thought of. */
const KINDS = ['basic', 'edge', 'turn', 'twizzle', 'transition', 'combination', 'jump', 'combo', 'position',
               'spin', 'step', 'sequence', 'hold', 'dance'];
const counts = Object.fromEntries(KINDS.map(k => [k, byKind(k).length]));
/* How many element pages draw the body as well as the tracing — counted, not claimed.
   The line below said every element had "the same three views of the body", which was never
   true: the twizzles, transitions and clusters draw a tracing and no body. */
const rigged = elements.filter(e => e.data.rig).length;

/* AN UNNAMED KIND IS A BUILD FAILURE, NOT A SENTENCE — 20/09/2026.

   This list used to degrade politely: anything it did not name was counted and the
   page printed "N of them in a category this page has not been taught to name". That
   is a tripwire wired into the page instead of into the build, and it did exactly what
   such a thing does. The spins went in on 19/09/2026 and **the live front page has been
   saying "5 of them in a category this page has not been taught to name" ever since** —
   shipped, visible, and read by nobody. A notice nobody reads is a decoration.

   `element-groups.js` already settled the argument for its own ordering: a section with
   no rank throws rather than sorting quietly to the bottom, because a hand-written list
   of what to show is how twenty-four twizzles fell through the featured filter. This is
   the same list one page along, so it gets the same answer. */
const unnamedKinds = [...new Set(elements.map(e => e.data.kind))].filter(k => !KINDS.includes(k));
if (unnamedKinds.length) throw new Error(
  `index.astro: the kind${unnamedKinds.length > 1 ? 's' : ''} ${unnamedKinds.map(k => `"${k}"`).join(', ')} ` +
  `${unnamedKinds.length > 1 ? 'are' : 'is'} not in KINDS, so the front page cannot name ` +
  `${unnamedKinds.length > 1 ? 'them' : 'it'}. Add to KINDS rather than letting the count absorb it.`);

/* THE OVERVIEW. Forwards before backwards, outside before inside, left before
   right — so the grid reads as the model rather than as an alphabetical accident,
   and the mirrored pair of any cell is the one beside it. Nothing here is a list
   of slugs: the page asks for the edges and sorts them by what they are. */
const ORDER = { dir: 'FB', edge: 'OI', foot: 'LR' };
const rank = e => ORDER.dir.indexOf(e.data.entry.dir) * 4
                + ORDER.edge.indexOf(e.data.entry.edge) * 2
                + ORDER.foot.indexOf(e.data.entry.foot);
const edges = byKind('edge').filter(e => e.data.entry).sort((a, b) => rank(a) - rank(b));

/* The first edge a skater is taught, found by what it is rather than by a slug
   typed in here — a file renamed by hand should break the build, not the link. */
const firstEdge = edges.find(e => label(e.data.entry) === 'LFO');

/* The one thing on this page that moves. A three turn, because it is the shortest
   demonstration of the argument the guide is making: same foot, same circle, one
   rotation, and the edge changes under you. Found the same way as the edges. */
const three = byKind('turn').find(e => e.data.turn === 'three' && label(e.data.entry) === 'LFO');
---
<Base title={null} subtitle="Every edge, turn, jump and position, drawn from three views on both feet, with the tests each one belongs to.">
  <h1>Field Guide to Figure Skating</h1>
  {/* 04/10/2026, Martyn (after his brother suggested "Rink guide"): keep the title,
     which says what kind of book this is, and say where it is used underneath. Set
     in the same style as the "also called" line under an element's title. */}
  <p class="aka">Made to be read at the rink.</p>
  <p class="lede">
    What each element actually is, drawn from three views and on both feet, with the{' '}
    {here && here.id !== 'uk' ? `${here.bodies} levels` : 'British Ice Skating tests'} it belongs to. Free to read, no account, and it keeps
    working when the signal does not.
  </p>

  <div class="unverified">
    <b>Not checked by a coach yet.</b> Every page here is written from public material
    and derived from first principles, and none of it has been checked yet.{' '}
    <a href={url('coaches/')}>Coaches, judges and technical officials can help verify it</a>:
    a page only loses this notice once real people have signed off the passage on it.
  </div>

  <h2>Every edge there is</h2>
  <p class="notation">
    Three letters: foot, direction, edge. <b>LFO</b> is a left foot travelling forwards
    on an outside edge; <b>RBI</b> is a right foot going backwards on an inside one.
    There are {counts.edge} of them, the dot marks where the blade goes down, and almost
    everything else in skating is one of these followed by another.
  </p>

  <div class="edge-grid">
    {edges.map(e => (
      <a href={url(`elements/${e.id}/`)}>
        <EdgeThumb entry={e.data.entry} />
        <b>{label(e.data.entry)}</b>
        <span>{e.data.name.replace(/ edge$/, '')}</span>
      </a>
    ))}
  </div>

  <p>
    Four shapes, twice over. Every cell above is the mirror of the one beside it,
    because which way a lobe curves is a product of exactly those three facts, so the
    guide stores the three and works the rest out. Each thing is drawn and written once,
    and a skater who rotates the other way gets the same detail as everyone else.
  </p>

  {three && (
    <>
      <h2>And what a turn does to one</h2>
      <p>
        It runs on its own. The foot and the circle stay the same: the
        skater rotates half a turn towards its centre and comes out backwards on the
        other edge of the same blade. Pause it, scrub it, slow it to an eighth, or
        mirror it and watch the same element come out the other way round.
      </p>
      <EdgeDiagram entry={three.data.entry} turn={three.data.turn} />
      <p>
        That is a {three.data.name.toLowerCase()}, and there are{' '}
        <a href={url('elements/')}>{counts.turn - 1} more turns</a> where it came from,
        plus {counts.basic} basics, {counts.twizzle} twizzles, {counts.transition} transitions,{' '}
        {counts.combination} clusters, {counts.jump} jumps, {counts.combo} jump combinations,{' '}
        {counts.spin} spins and{' '}
        {counts.position} positions. Across all of them, {rigged} draw the skater's body in three
        views as well as the tracing.
      </p>
    </>
  )}

  <h2>Start here</h2>
  <ul class="plain">
    <li>
      <a href={url('elements/')}>Elements</a>
      <span>
        {/* A line that ends in an expression eats the newline after it, so the
            spaces are explicit. Two counts ran together as "32 twizzles,36
            transitions" before they were. */}
        {counts.basic} basics, {counts.edge} edges, {counts.turn} turns,{' '}
        {counts.twizzle} twizzles, {counts.transition} transitions,{' '}
        {counts.combination} clusters, {counts.jump} jumps, {counts.combo} jump combinations,{' '}
        {counts.spin} spins,{' '}
        {counts.position} positions, {counts.step + counts.sequence} steps and sequences{' '}
        and {counts.dance} pattern dances with the {counts.hold} holds they use
      </span>
    </li>
    <li>
      <a href={url('tests/')}>Tests</a>
      <span>which syllabus each element belongs to, {tests.length} recorded so far</span>
    </li>
    <li>
      <a href={url('first-session/')}>Your first session</a>
      <span>getting on and off the ice, which way to skate, and never standing on metal</span>
    </li>
    <li>
      <a href={url('glossary/')}>Glossary</a>
      <span>the words skaters and coaches use, each in a sentence or two</span>
    </li>
    <li>
      <a href={url('kit/')}>Kit</a>
      <span>the blade, the boot and looking after them</span>
    </li>
    <li>
      <a href={url('off-ice/')}>Off the ice</a>
      <span>what the body needs for the elements, and which elements need it</span>
    </li>
    <li>
      <a href={url('grades/')}>Grades</a>
      <span>{here ? `${here.adj} levels first, then every other country's` : 'each country\'s levels, from the first glide up'}</span>
    </li>
    <li>
      <a href={url('rig/')}>Body frame</a>
      <span>one rig, three views, one clock: what the rest of the body is doing</span>
    </li>
    <li>
      <a href={url('search/')}>Search</a>
      <span>type an edge code, a name, or the name your coach uses for it</span>
    </li>
  </ul>

  {firstEdge && (
    <p>
      If you have never read a page here before, start with the{' '}
      <a href={url(`elements/${firstEdge.id}/`)}>left forward outside edge</a>. Everything
      else in the guide is that page with one or two things changed.
    </p>
  )}

  {here ? (
    <>
      <h2>{here.adj} grades</h2>
      <ul class="plain">
        {myGrades.map(g => <li><a href={url(`grades/${g.id}/`)}>{g.data.name}</a><span>{g.data.summary}</span></li>)}
      </ul>
      <p>
        This is the copy of the guide for {here.name}: elements carry {here.adj} names where
        a programme here uses its own, and each one says where it sits in these grades. The{' '}
        <a href={curl(undefined, '')} data-cc="all">copy for every country</a> is still there.
      </p>
    </>
  ) : (
    <>
      <h2>Where you skate</h2>
      <p>
        There is a copy of the guide for each of four countries. It puts that country's
        levels first, uses its programmes' names for a move where they differ, and says
        on each element where it sits in those grades:{' '}
        {COUNTRIES.map((c, i) => <>{i > 0 ? (i === COUNTRIES.length - 1 ? ' and ' : ', ') : ''}<a href={curl(c.id, '')}>{c.short}</a></>)}.
        The Country button at the top switches between them and remembers the choice.
      </p>
    </>
  )}

  <h2>What this is</h2>
  <p>
    A personal project, built in the evenings, for skaters and parents who have been
    handed a syllabus and told to go and learn a bracket. It is not affiliated with
    British Ice Skating or with any club, it reproduces no governing body's material,
    and it will not ever charge for access. <a href={url('about/')}>More about it here</a>.
  </p>

  <p style="margin-top:1.5rem;font-size:.9rem;color:var(--ink-soft)">
    {elements.length} elements recorded across {tests.length} tests.
  </p>
</Base>

<style>
  /* Four across on anything with room, two on a phone — never three, because the
     eight are four mirrored pairs and an odd column splits a pair across a row. */
  .edge-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:.7rem;margin:1.4rem 0 1.6rem}
  @media (max-width:640px){ .edge-grid{grid-template-columns:repeat(2,1fr)} }

  .edge-grid a{display:block;text-decoration:none;color:var(--ink);text-align:center;
    background:var(--ice);border:1px solid var(--ice-line);border-radius:12px;
    padding:.55rem .4rem .65rem}
  .edge-grid a:hover,.edge-grid a:focus-visible{border-color:var(--accent)}
  .edge-grid b{display:block;margin-top:.35rem;font-size:1rem;letter-spacing:.05em}
  .edge-grid span{display:block;margin-top:.1rem;line-height:1.25;
    font-family:ui-sans-serif,-apple-system,sans-serif;font-size:.7rem;color:var(--ink-soft)}
</style>
