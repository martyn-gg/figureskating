---
import DancePattern from '../../../components/DancePattern.astro';
import { getCollection, render } from 'astro:content';
import Base from '../../../layouts/Base.astro';
import Unverified from '../../../components/Unverified.astro';
import EdgeDiagram from '../../../components/EdgeDiagram.astro';
import EdgeThumb from '../../../components/EdgeThumb.astro';
import PathThumb from '../../../components/PathThumb.astro';
import { familyOf, teachRank, syllabusRank } from '../../../lib/element-groups.js';
import { FOUNDATIONS, reasonFor } from '../../../lib/foundations.js';
import BodyFrame from '../../../components/BodyFrame.astro';
import { DANCE_KEY, stepLink, patternBeats } from '../../../lib/dance.js';
import Edge from '../../../components/Edge.astro';
import { label, mirror, describeTurn, describeChain, describeEdge, exitState, chainStates, chainReturns, lobeContinues, lobeSense, LANDING, JUMPS, ALL_TURNS, confusableWith } from '../../../lib/skating.js';

export async function getStaticPaths() {
  const elements = await getCollection('elements');
  /* Each element once at the root and once per country: src/lib/country.js. */
  return COPIES.flatMap(cc => elements.map(e => ({ params: { cc, slug: e.id }, props: { entry: e } })));
}
import { curl, COPIES, COUNTRIES, countryOf, nameIn } from '../../../lib/country.js';
const { cc } = Astro.params;
const url = p => curl(cc, p);
const { entry } = Astro.props;
const d = entry.data;
/* The diagram this page's rink pattern was measured from, if it has one; the footer
   says so in place of its usual "no governing body's material" line. */
const patternFiles = import.meta.glob('../../../data/patterns/*.json', { eager: true });
const patternSource = patternFiles[`../../../data/patterns/${entry.id}.json`]?.default?.source;
const { Content } = await render(entry);

/* Every test that references this element, in any country. Free, because tests
   point at elements and never the other way round. */
const allTests = await getCollection('tests');
const allExercises = await getCollection('exercises');
/* Two routes in, because a test either owns a flat list of elements or owns
   exercises that do. Both are answered by pointing at this element, never by this
   element knowing about them. */
const exercisesHere = allExercises.filter(x => x.data.elements.some(r => r.id === entry.id))
  .sort((a, b) => a.data.test.id.localeCompare(b.data.test.id) || a.data.order - b.data.order);
const tests = allTests.filter(t =>
  t.data.elements.some(r => r.id === entry.id) ||
  exercisesHere.some(x => x.data.test.id === t.id));
const testName = id => allTests.find(t => t.id === id)?.data.name ?? id;

/* THE COUNTRY'S OWN NAME AND GRADES — 03/10/2026. On a country copy the page is
   headed with that country's word for the movement where its programme uses a
   different one, and the guide's own name moves into "also called". */
const here = countryOf(cc);
const shown = nameIn(d, cc);
const renamed = shown !== d.name;
const aka = renamed
  ? [d.name, ...d.aliases.filter(a => a.toLowerCase() !== shown.toLowerCase())]
  : d.aliases;
/* Where this element sits in the country's grades: every level of every programme
   in that country whose list names it. Only on a country copy, and only that
   country's, because Martyn's rule for the grades is that they lead into the
   elements and do not bulk them out. */
const slugOf = t => t.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '');
const myGrades = here
  ? (await getCollection('grades'))
      .filter(g => g.data.country === here.grades)
      .sort((a, b) => a.data.order - b.data.order)
      .map(g => ({ g, levels: g.data.levels.filter(l => l.items.some(i => i.elements.some(r => r.id === entry.id))) }))
      .filter(x => x.levels.length > 0)
  : [];

/* Nothing below is stored on the element. */
const turnLine = d.entry && d.turn ? describeTurn(d.entry, d.turn) : null;
const turnExit = d.entry && d.turn ? exitState(d.entry, d.turn) : null;
/* A cluster: every edge it passes through, derived by chaining. */
const chain = d.turns ?? null;
const chainRoute = chain ? chainStates(d.entry, chain) : null;
const chainLine = chain ? describeChain(d.entry, chain) : null;
const mirrored = d.entry ? mirror(d.entry) : null;
const mirrorJump = d.jump ? { takeoff: mirror(d.jump.takeoff), landing: mirror(d.jump.landing) } : null;
/* WHICH JUMPS SHARE A TAKEOFF EDGE IS THE MODEL'S QUESTION, and skating.js already
   answers it. This was a second copy of that rule — same result, computed from the
   page's own frontmatter and keyed on the jump's NAME — which is the shape this
   repository keeps getting caught by: two expressions of one fact, drifting apart
   the first time one of them is edited. Look the key up, then ask the model. */
const jumpKey = d.jump ? Object.keys(JUMPS).find(k => JUMPS[k].name.toLowerCase() === d.name.toLowerCase()) : null;
const shares = jumpKey ? confusableWith(jumpKey) : [];
/* What separates a pair that share a takeoff edge, derived rather than written:
   either one uses the pick and the other does not, or they differ in rotations.
   There is no third answer, because the takeoff edge is the only other thing a
   jump is made of. */
const sharesDetail = shares.map(k => ({
  name: JUMPS[k].name.toLowerCase(),
  differsBy: JUMPS[k].assisted !== d.jump.assisted ? 'the pick' : 'the number of rotations',
}));
const allElements = await getCollection('elements');
const prereqs = d.prerequisites.map(r => allElements.find(e => e.id === r.id)).filter(Boolean);

/* WHAT THIS LEADS TO — 19/09/2026, Martyn: say how a basic prepares a skater for
   something harder, and link to it.

   Inverted from `prerequisites` rather than stored, which is the same rule that
   keeps exit edges out of the element files: a second field would be a second
   source of truth and the second one always goes stale. So a page's "leads to"
   list is every element that names it as something to build on, and the two
   directions of every link are one fact.

   It earns its place most on the basics, which are the bottom of the ladder and
   whose whole reason for existing is what sits above them — a skater looking at
   the push wants to know that it is what an edge is made of. Sorted so the
   nearest thing comes first: a basic's own siblings before the edges, the edges
   before the turns built on them.

   Capped, because forward-stroking is under every edge in the guide and a list of
   thirty is a wall rather than a way through. The count is printed either way. */
/* THE SAME MOVEMENT FROM A DIFFERENT ENTRY EDGE — 19/09/2026, Martyn: link to an
   element and give a dropdown to move between the variations.

   The page already had a list for the OTHER axis — everything else that starts on
   this entry edge — and nothing at all for this one, which is the axis a skater
   actually moves along. You are on the left forward outside three and you want the
   right one; the guide made you go back to the elements page to find it.

   A `details` disclosure and plain links rather than a select and a script. This
   site is a PWA a skater opens at a rink, and a switcher that needs JavaScript is
   the wrong bet for a cold phone on bad signal — the links work with none, and they
   are real URLs, which is the whole reason the per-state pages were kept. */
const familyKey = familyOf(d);
const variations = familyKey
  ? allElements.filter(e => familyOf(e.data) === familyKey && e.data.kind === d.kind)
      .sort((a, b) => teachRank(a.data) - teachRank(b.data))
  : [];
const others = variations.filter(e => e.id !== entry.id);

const KIND_NEAR = ['basic', 'edge', 'position', 'transition', 'turn', 'twizzle', 'jump', 'spin', 'combination', 'sequence'];
const leadsToAll = allElements
  .filter(e => e.id !== entry.id && (e.data.prerequisites || []).some(r => r.id === entry.id))
  .sort((a, b) => (KIND_NEAR.indexOf(a.data.kind) - KIND_NEAR.indexOf(b.data.kind))
                  || a.data.name.localeCompare(b.data.name));
const leadsTo = leadsToAll.slice(0, 8);

/* WHY, AS WELL AS WHAT — 03/10/2026. On a basic, each element built on it carries the
   reason from lib/foundations.js, and a family that shares a reason (the four forward
   edges) is one line with four links. Grouped, the list is short enough not to need
   the cap, so a basic shows everything built on it. Other pages keep the cap and the
   summaries. tools/foundations.mjs holds every basic link to having a reason. */
const isFoundation = Boolean(FOUNDATIONS[entry.id]);
const leadsGroups = [];
if (isFoundation) {
  for (const e of leadsToAll) {
    const why = reasonFor(entry.id, e.id) || e.data.summary;
    const g = leadsGroups.find(x => x.why === why);
    if (g) g.items.push(e); else leadsGroups.push({ why, items: [e] });
  }
}

/* Which way the tracing goes. Derived from the same function the diagram uses, so
   the sentence and the picture cannot disagree. */
const spin = d.entry ? (lobeSense(d.entry.foot, d.entry.edge, d.entry.dir) > 0 ? 'anticlockwise' : 'clockwise') : null;

/* Everything else that starts on this entry edge. At six elements this was not worth
   having; at forty it is the main way anyone will move around the guide. The plain
   edge lists its four turns, a turn lists its three siblings and the edge itself. */
const family = d.entry ? allElements.filter(e =>
  e.data.entry && label(e.data.entry) === label(d.entry) && e.id !== entry.id
  && ['edge', 'turn', 'transition'].includes(e.data.kind)
  && !prereqs.some(p => p.id === e.id)) : [];
/* Clusters starting here get their own list. Folded into the one above they would
   bury the single turns, which are what most people arrive looking for. */
const clusters = d.entry ? allElements.filter(e =>
  e.data.kind === 'combination' && e.data.entry && label(e.data.entry) === label(d.entry)
  && e.id !== entry.id).sort((a, b) => a.data.turns.length - b.data.turns.length) : [];
/* Learning order, from the syllabus, as on the section pages (element-groups.js):
   the plain edge first, then each turn by the first exercise asking for it. */
const SR = syllabusRank(allExercises);
const rankOf = e => e.data.turn ? SR.ofElement(e.id) : -1;
family.sort((a, b) => rankOf(a) - rankOf(b));
clusters.sort((a, b) => SR.ofElement(a.id) - SR.ofElement(b.id) || a.data.turns.length - b.data.turns.length);
---
<Base title={shown} subtitle={d.summary} kind={d.kind} measured={patternSource}>
  <h1>{shown}</h1>
  <p class="lede">{d.summary}</p>
  {/* The guide keeps the governing body's word and never translates it silently.
      This is not a translation — it is so a reader searching for what their coach
      calls it lands somewhere. src/content.config.ts has the rule. */}
  {aka.length > 0 &&
    <p class="aka">Also called {aka.map((a, i) =>
      <>{i > 0 ? (i === aka.length - 1 ? ' or ' : ', ') : ''}<b>{a}</b></>)}.
      {' '}<a href={url('elements/other-names/')}>Other names</a>.</p>}

  <div class="meta">
    <span class="chip">{d.kind}</span>
    {d.entry && <span class="chip">entry <b><Edge state={d.entry} /></b></span>}
    {turnExit && <span class="chip">exit <b><Edge state={turnExit} /></b></span>}
    {chainRoute && <span class="chip">exit <b><Edge state={chainRoute.at(-1)} /></b></span>}
    {chain && <span class="chip"><b>{chain.length}</b> turns</span>}
    {chainRoute && new Set(chainRoute.map(st => st.foot)).size === 1
      && <span class="chip">one foot throughout</span>}
    {chainRoute && chainReturns(d.entry, chain)
      && <span class="chip">returns to <b><Edge state={d.entry} /></b></span>}
    {d.jump && <span class="chip">takeoff <b><Edge state={d.jump.takeoff} /></b></span>}
    {d.jump && <span class="chip">landing <b><Edge state={d.jump.landing} /></b></span>}
    {d.jump && <span class="chip">{d.jump.assisted ? 'toe jump' : 'edge jump'}</span>}
    {d.jump && <span class="chip"><b>{d.jump.rotations}</b> rotation{d.jump.rotations === 1 ? '' : 's'}</span>}
  </div>
  {/* The reader's own tick, kept in their browser. Base.astro wires it up and
      unhides it; without JavaScript it stays hidden. */}
  <label class="can" hidden><input type="checkbox" data-tick={`can:${entry.id}`} /> I can do this</label>

  {others.length > 0 && (
    <details class="variations">
      <summary>
        {d.entry ? <>On <b>{label(d.entry)}</b></> : <>This one</>}
        {' '}· {others.length} other {others.length === 1 ? 'entry' : 'entries'}
      </summary>
      <ul class="plain">
        {variations.map(v => (
          <li>
            {v.id === entry.id
              ? <b>{v.data.entry ? label(v.data.entry) : v.data.name} (this page)</b>
              : <a href={url(`elements/${v.id}/`)}>{v.data.entry ? label(v.data.entry) : v.data.name}</a>}
            <span>{v.data.summary}</span>
          </li>
        ))}
      </ul>
    </details>
  )}

  <Unverified verified={d.verified} />

  {d.entry && <EdgeDiagram entry={d.entry} turn={d.turn ?? null} turns={d.turns ?? null} />}

  {/* AN ELEMENT WITH NO ENTRY EDGE STILL LEAVES A MARK — 19/09/2026. The basics
      arrived on 06/09 and twenty-two of them drew nothing, which is exactly the
      fault the jumps had above and for the same underlying reason: the page could
      only draw what it could hand to `buildTrace`, and `buildTrace` wants an entry
      edge. A glide has none, a slalom has four, and half of them have two blades on
      the ice.

      `trace` carries the segments instead, in a rig move's own vocabulary, and
      `PathThumb` runs them through `buildPath` — the function that draws the tracing
      under the body frame. Two blades draw two lines, because that is the element. */}
  {!d.entry && d.trace && (
    <figure class="jumptrace">
      <PathThumb trace={d.trace} box={200} />
      <figcaption>
        The mark this leaves on the ice{d.trace.feet === 2 ? ', both blades' : ''}. A
        straight line is a claim as much as a curve is: it says the blade is flat, and
        a blade that is not flat is an edge and a different element.
      </figcaption>
    </figure>
  )}

  {/* A JUMP HAS TWO EDGES AND THE GUIDE WAS DRAWING NEITHER. Six of the seven jump
      pages contained no picture at all — not a tracing, not a rig — on a site whose
      own subtitle promises every jump drawn. These come from `jump:`, which every
      page already carries, so there is no new data and nothing to keep in step.

      EdgeThumb rather than EdgeDiagram, for the reason the front page uses it: it
      draws in the frontmatter and ships a path, where the full instrument costs a
      script and a requestAnimationFrame loop per copy. Two of those on an element
      page that may already be running a body frame is a poor trade for a curve that
      does not need to move. */}
  {d.jump && (
    <figure class="jumptrace">
      <div class="jt-pair">
        <div>
          <EdgeThumb entry={d.jump.takeoff} />
          <b>{label(d.jump.takeoff)}</b><span>takes off</span>
        </div>
        <div>
          <EdgeThumb entry={d.jump.landing} />
          <b>{label(d.jump.landing)}</b><span>lands</span>
        </div>
      </div>
      <figcaption>
        The two edges, drawn. What happens between them is not: a tracing is the record
        of a blade on the ice, and for most of a jump the blade is not on it.
        {/* Two jumps leave and return to the same edge, and drawn side by side that
            reads as a mistake unless the page says otherwise. Derived from the two
            labels rather than listed, so a jump added tomorrow gets it too. */}
        {label(d.jump.takeoff) === label(d.jump.landing) && (
          <> These two are the same curve because they are the same edge: it leaves and
          returns to <b>{label(d.jump.takeoff)}</b>.</>
        )}
        {sharesDetail.length > 0 && (
          <> Each of these curves is drawn by more than one jump. What separates this
          one from the {sharesDetail.map(x => x.name).join(' and the ')} is{' '}
          {[...new Set(sharesDetail.map(x => x.differsBy))].join(' and ')}, and no curve
          can show either.</>
        )}
      </figcaption>
    </figure>
  )}

  {d.rig && <BodyFrame move={d.rig} />}

  {/* A PATTERN DANCE'S STEPS — 03/10/2026. The rink pattern where it has been measured
      (components/DancePattern.astro), then the step table. src/lib/dance.js says where
      the steps come from and when a step links to an element. */}
  {d.dance && (() => {
    const D = d.dance, ids = new Set(allElements.map(e => e.id));
    const used = D.steps ? [...new Set(D.steps.map(s => s.how).filter(Boolean))] : [];
    return (<>
      <h2>The dance</h2>
      <p>{D.rhythm} in {D.meter}, {D.bpm} beats a minute. The hold is {D.hold}.
        {' '}{D.sameSteps ? 'Both partners skate the same steps.' : 'The partners skate different steps.'}
        {' '}{(D.steps || D.chart).length} steps and {patternBeats(D)} beats to one pattern.</p>
      <DancePattern slug={entry.id} dance={{ ...D, name: d.name }} />
      {D.chart && (<>
        <table class="grid steps">
          <thead><tr><th>Step</th><th>Hold</th>
            {D.sameSteps ? <th>Both partners</th> : <><th>Lead</th><th>Follow</th></>}
            <th>Beats</th></tr></thead>
          <tbody>
            {D.chart.map(r => <tr><td>{r.n}</td><td>{r.hold}</td><td><b>{r.lead}</b></td>
              {!D.sameSteps && <td><b>{r.follow}</b></td>}<td>{r.beats.replace(/\+/g, ' + ')}</td></tr>)}
          </tbody>
        </table>
        <p class="small">The steps are in the rulebook's own notation: foot, direction and edge,
          with Pr for a progressive, Ch for a chassé, SwR for a swing roll, XB and XF for a cross
          step behind or in front, 3 for a three turn, CSt and SSt for C and S steps, Op for open
          and Cl for closed. From the step chart in US Figure Skating's 2026-27 rulebook.</p>
      </>)}
      {D.steps && (<>
        <table class="grid steps">
          <thead><tr><th>Step</th><th>Edge</th><th>Beats</th><th>How</th></tr></thead>
          <tbody>
            {D.steps.map((s, i) => {
              const k = s.how && DANCE_KEY[s.how], ln = stepLink(D.steps, i);
              const word = k && (ln && ln.slug && ids.has(ln.slug)
                ? <a href={url(`elements/${ln.slug}/`)}>{k.word}</a> : k.word);
              return <tr><td>{s.n}</td><td><b>{s.edge}</b></td>
                <td>{Array.isArray(s.beats) ? s.beats.join(' + ') : s.beats}</td>
                <td>{word}{k && s.opt ? '; ' : ''}{s.opt}</td></tr>;
            })}
          </tbody>
        </table>
        <p class="small">Edges are written foot, direction, edge, and a change of edge carries
          both letters. The steps and beats are read off the dance diagram in US Figure
          Skating's 2026-27 rulebook{used.length > 0 && <>, and the words for {used.map((h, i) =>
            <>{i > 0 ? (i === used.length - 1 ? ' and ' : ', ') : ''}{h}</>)} come from its key</>}.</p>
      </>)}
    </>);
  })()}

  <Content />

  {/* Every paragraph below is computed from an entry edge or a jump, and the basics
      and the slip step have neither — so for 23 pages this printed a heading over an
      empty box. Ask the same question the paragraphs ask before printing either.
      tools/sections.mjs asserts it against the built page. */}
  {(d.entry || d.jump) && (<>
  <h2>Derived</h2>
  <div class="derived">
    {(d.entry || d.jump) && (
      <p class="notation">
        <b>{label(d.entry ?? d.jump.takeoff)}</b> is three letters (foot, direction, edge):
        {' '}{describeEdge(d.entry ?? d.jump.takeoff)}. Every edge in the guide is written
        that way, so <b>RBI</b> is a right foot travelling backwards on an inside edge.
      </p>
    )}
    {turnLine && <p>{turnLine}</p>}
    {chainLine && <p>{chainLine}</p>}
    {chainRoute && (
      <p>Nothing above is stored on this page. The cluster records its entry edge and the
        order of its turns; every edge in between is chained out of the same rule that
        draws a single turn.</p>
    )}
    {d.entry && !d.turn && !d.turns && (
      <p>{label(d.entry)} traces {spin === 'anticlockwise' ? 'an' : 'a'} {spin} lobe seen from
        above the ice. Change any one of the three letters and it curves the other way;
        change two and it curves the same way again.</p>
    )}
    {d.jump && (
      <p>{[
        `Takes off ${label(d.jump.takeoff)} and lands ${label(d.jump.landing)}`,
        label(d.jump.landing) === label(LANDING)
          ? ', the same edge every jump in this guide lands on, so the takeoff is what tells them apart.'
          : '.',
        d.jump.assisted ? ' The toe pick provides the vault.' : ' The spring comes from the edge, with no pick.',
      ].join('')}</p>
    )}
    {d.jump && shares.length > 0 && (
      <p>Shares its takeoff edge with the {shares.map(k => JUMPS[k].name.toLowerCase()).join(' and the ')}:
        the pair that get mistaken for each other.</p>
    )}
    {d.jump && shares.length === 0 && (
      <p>No other jump takes off from {label(d.jump.takeoff)}. That is exactly why it drifts:
        roll onto the other edge and it becomes a different jump entirely.</p>
    )}
    {mirrored && <p>A skater who rotates the other way does the same thing from <b>{label(mirrored)}</b>. Same element, mirrored.</p>}
    {mirrorJump && (
      <p>A skater who rotates clockwise takes off <b>{label(mirrorJump.takeoff)}</b> and lands
        {' '}<b>{label(mirrorJump.landing)}</b>: the same jump, mirrored.</p>
    )}
  </div>
  </>)}

  {prereqs.length > 0 && (
    <>
      <h2>Build on</h2>
      <ul class="plain">
        {prereqs.map(p => <li><a href={url(`elements/${p.id}/`)}>{p.data.name}</a><span>{reasonFor(p.id, entry.id) || p.data.summary}</span></li>)}
      </ul>
    </>
  )}

  {leadsTo.length > 0 && (
    <>
      <h2>Leads to</h2>
      <p class="lede">
        {leadsToAll.length === 1
          ? 'One element in the guide is built on this one.'
          : <>{leadsToAll.length} elements in the guide are built on this one{!isFoundation && leadsToAll.length > leadsTo.length
              ? <>, and the {leadsTo.length} nearest are listed here</> : null}.</>}
      </p>
      <ul class="plain">
        {isFoundation
          ? leadsGroups.map(g => <li data-foundation>{g.items.map((p, i) => <>{i > 0 ? ', ' : ''}<a href={url(`elements/${p.id}/`)}>{p.data.name}</a></>)}<span>{g.why}</span></li>)
          : leadsTo.map(p => <li><a href={url(`elements/${p.id}/`)}>{p.data.name}</a><span>{p.data.summary}</span></li>)}
      </ul>
    </>
  )}

  {family.length > 0 && (
    <>
      <h2>From {label(d.entry)}</h2>
      <ul class="plain">
        {family.map(f => (
          <li>
            <a href={url(`elements/${f.id}/`)}>{f.data.name}</a>
            <span>{f.data.turn
              ? `exits ${label(exitState(d.entry, f.data.turn))} · ${ALL_TURNS[f.data.turn].changesFoot ? 'changes foot' : 'same foot'}, the edge ${ALL_TURNS[f.data.turn].edgeChanges ? 'changes' : 'holds'}, ${ALL_TURNS[f.data.turn].reversesDir === false ? 'the direction holds' : 'the direction reverses'}, the lobe ${lobeContinues(d.entry, f.data.turn) ? 'continues' : 'reverses'}`
              : 'the plain edge, with no turn on it'}</span>
          </li>
        ))}
      </ul>
    </>
  )}

  {clusters.length > 0 && (
    <>
      <h2>Clusters from {label(d.entry)}</h2>
      <ul class="plain">
        {clusters.map(c => (
          <li>
            <a href={url(`elements/${c.id}/`)}>{c.data.name}</a>
            <span>{chainStates(d.entry, c.data.turns).map(label).join(' → ')}</span>
          </li>
        ))}
      </ul>
    </>
  )}

  <h2>Appears in</h2>
  {here && (
    <div class="mygrades">
      <p class="mg-head">In {here.name}'s grades</p>
      {myGrades.length > 0
        ? <ul>{myGrades.map(({ g, levels }) => (
            <li><a href={url(`grades/${g.id}/`)}>{g.data.name}</a>:{' '}
              {levels.map((l, i) => <>{i > 0 ? ', ' : ''}<a href={url(`grades/${g.id}/#${slugOf(l.name)}`)}>{l.name}</a></>)}</li>
          ))}</ul>
        : <p>None of the {here.adj} level lists in this guide name it{here.id === 'uk' ? ' outside the Skills tests below' : ''}.</p>}
    </div>
  )}
  {(!here || here.id === 'uk')
    ? (tests.length === 0
      ? <p style="color:var(--ink-soft);font-size:.9rem">No test syllabus recorded yet.</p>
      : <ul class="plain">{tests.map(t => (
          <li><a href={url(`tests/${t.id}/`)}>{t.data.name}</a><span>{t.data.governingBody} · level {t.data.level}</span></li>
        ))}</ul>)
    : tests.length > 0 && (
      <p class="also">In British Ice Skating's tests:{' '}
        {tests.map((t, i) => <>{i > 0 ? ', ' : ''}<a href={url(`tests/${t.id}/`)}>{t.data.name}</a></>)}.</p>
    )}
  {!here && (
    <p class="also">Where it sits in one country's grades is on that country's copy of this page:{' '}
      {COUNTRIES.map((c, i) => <>{i > 0 ? (i === COUNTRIES.length - 1 ? ' or ' : ', ') : ''}<a href={curl(c.id, `elements/${entry.id}/`)} data-cc={c.id}>{c.short}</a></>)}.</p>
  )}

  {(!here || here.id === 'uk') && exercisesHere.length > 0 && (
    <ul class="plain">{exercisesHere.map(x => (
      <li>
        <a href={url(`exercises/${x.id}/`)}>{testName(x.data.test.id)}, exercise {x.data.order}: {x.data.name}</a>
        <span>{x.data.summary}</span>
      </li>
    ))}</ul>
  )}
</Base>

