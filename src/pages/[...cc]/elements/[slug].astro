  .mygrades .mg-head{margin:0 0 .3rem;font-weight:600}
  .mygrades ul{margin:0;padding:0 0 0 1.1rem}
  .mygrades li{margin:.2rem 0}
  .mygrades p{margin:0}
  .also{color:var(--ink-soft);font-size:.95rem}
</style>
